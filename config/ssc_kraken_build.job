# =========================================================================================================================
# VIROnator Submodule: Kraken2 Custom Database Build Job Template (kraken2/2.1.2)
# Builds a custom Kraken2 index from a composite reference FASTA and NCBI taxonomy.
# Runs on a single temporary GCP worker VM with a large attached local persistent disk (/mnt/disks/staff, 3000 GB).
# Avoids using GCS directly or $HOME (15 GB quota) for build operations.
# =========================================================================================================================

job_name=KRAKEN2_DB_BUILD
job_identifier=KRAKEN2_DB_BUILD
machine_type=n2-standard-128

####
#### Buckets
####

input_bucket=gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/jobexec_kraken_build_MCBiobank_hg38/input
output_bucket=gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/jobexec_kraken_build_MCBiobank_hg38/output
log_bucket=gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/jobexec_kraken_build_MCBiobank_hg38/logs

####
#### Tools
####

# Binaries are loaded from /mnt/disks/staff/bin/ (copied from cluster /usr/local/biotools/kraken2/2.1.2/bin/)
#repo=gs://ml-65e4-phi-biotools-p-rsa-us-central1-p/jobexec/repositories/rocky8.repo
#tool=kraken2

####
#### Post-Job Configuration
####

clear_output=false
clear_input=true 

####
#### Script to run
####

commands_start

# Strict shell error handling
set -euo pipefail

# Persistent Logging Setup on Attached Working Disk
WORK_DISK="/mnt/disks/staff"
LOG_DIR="${WORK_DISK}/kraken_build_logs"
mkdir -p "${LOG_DIR}"
BUILD_LOG="${LOG_DIR}/kraken2_build_$(date +%Y%m%d_%H%M%S).log"
LOG_GCS_DEST="ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/jobexec_kraken_build_MCBiobank_hg38/logs"

# Ensure all output is tee-ed to the persistent log file
exec > >(tee -a "${BUILD_LOG}") 2>&1

echo "=========================================================================================="
echo " Starting Kraken2 Database Build Job"
echo " Start Timestamp: $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo " Node Hostname  : $(hostname)"
echo " Working Log    : ${BUILD_LOG}"
echo "=========================================================================================="

# Error handler: Upload build log to GCS if failure occurs before worker termination
trap 'EXIT_CODE=$?; if [ ${EXIT_CODE} -ne 0 ]; then echo "[$(date)] [FATAL] Job failed with exit code ${EXIT_CODE}. Uploading diagnostic log to gs://${LOG_GCS_DEST}/..."; gsutil -m cp "${BUILD_LOG}" "gs://${LOG_GCS_DEST}/" 2>/dev/null || true; fi; exit ${EXIT_CODE}' EXIT

# Environment module loading for kraken2
if command -v module >/dev/null 2>&1 || [ -f /usr/share/modules/init/bash ]; then
    [ -f /usr/share/modules/init/bash ] && . /usr/share/modules/init/bash 2>/dev/null || true
    module load kraken2/2.1.2 2>/dev/null || module load kraken2 2>/dev/null || true
fi

# Tool binary verification
KRAKEN_BUILD_BIN="kraken2-build"
if ! command -v "${KRAKEN_BUILD_BIN}" >/dev/null 2>&1; then
    if [ -x "/mnt/disks/staff/bin/kraken2-build" ]; then
        KRAKEN_BUILD_BIN="/mnt/disks/staff/bin/kraken2-build"
    elif [ -x "/usr/local/biotools/kraken2/2.1.2/bin/kraken2-build" ]; then
        KRAKEN_BUILD_BIN="/usr/local/biotools/kraken2/2.1.2/bin/kraken2-build"
        export PATH="/usr/local/biotools/kraken2/2.1.2/bin:${PATH}"
    else
        echo "[ERROR] kraken2-build executable not found in PATH, /mnt/disks/staff/bin/, or /usr/local/biotools/kraken2/2.1.2/bin! Aborting."
        exit 1
    fi
fi
echo "[INFO] Using kraken2-build binary: ${KRAKEN_BUILD_BIN}"

# Configure Build Variables
SOURCE_FASTA_GCS="gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/refs/combined_GRCh38_full_analysis_set_plus_decoy_hla_no_ebv_modified.renamed_HumanViral_Reference_02-07-2022_modified_SnapGene_modified_mm39_modified.fa"
TAXONOMY_GCS="gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/refs/kraken_HumanViral_Reference_02-07-2022_modified_SnapGene_modified_mm39_modified/taxonomy"
DEST_GCS="gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/refs/kraken_HumanViral_Reference_02-07-2022_modified_SnapGene_modified_mm39_modified"
DB="/mnt/disks/staff/refs/kraken_HumanViral_Reference_02-07-2022_modified_SnapGene_modified_mm39_modified"
TAXONOMY_DIR="${DB}/taxonomy"
BUILD_THREADS="32"

FASTA_FILENAME="$(basename "${SOURCE_FASTA_GCS}")"
LOCAL_FASTA="${WORK_DISK}/${FASTA_FILENAME}"

echo "[INFO] Target Local Database Directory : ${DB}"
echo "[INFO] Local Taxonomy Directory        : ${TAXONOMY_DIR}"
echo "[INFO] Source FASTA GCS URI            : ${SOURCE_FASTA_GCS}"
echo "[INFO] Source Taxonomy GCS URI         : ${TAXONOMY_GCS}"
echo "[INFO] Target Destination GCS URI      : ${DEST_GCS}"
echo "[INFO] Build CPU Threads Allocated     : ${BUILD_THREADS}"

# Step 1: Create local directory structure on large attached disk
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [STEP 1/6] Creating local database directories on ${WORK_DISK}..."
mkdir -p "${TAXONOMY_DIR}"

# Step 2: Acquire and unpack NCBI taxonomy (copy from GCS if available, or download directly)
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [STEP 2/6] Preparing NCBI taxonomy in ${TAXONOMY_DIR}/..."

# 2a. Attempt copy from GCS taxonomy directory if files/archives already exist
echo "Checking GCS taxonomy source (${TAXONOMY_GCS})..."
gsutil -m cp -r "${TAXONOMY_GCS}/*" "${TAXONOMY_DIR}/" 2>/dev/null || true

# 2b. Unpack taxdump archive if present and valid locally
if [ -f "${TAXONOMY_DIR}/taxdump.tar.gz" ]; then
    echo "Verifying integrity of ${TAXONOMY_DIR}/taxdump.tar.gz..."
    if tar -tzf "${TAXONOMY_DIR}/taxdump.tar.gz" >/dev/null 2>&1; then
        echo "Unpacking valid taxdump.tar.gz..."
        tar -xzf "${TAXONOMY_DIR}/taxdump.tar.gz" -C "${TAXONOMY_DIR}/"
    else
        echo "[WARNING] Existing taxdump.tar.gz is truncated or corrupted (e.g. partial GCS copy). Deleting to fetch fresh copy..."
        rm -f "${TAXONOMY_DIR}/taxdump.tar.gz"
    fi
fi

# 2c. Decompress any valid .gz archives (accession2taxid, etc.)
for gz_file in "${TAXONOMY_DIR}"/*.gz; do
    if [ -f "${gz_file}" ] && [ "$(basename "${gz_file}")" != "taxdump.tar.gz" ]; then
        if gzip -t "${gz_file}" 2>/dev/null; then
            echo "Decompressing $(basename "${gz_file}")..."
            gunzip -f "${gz_file}" || true
        else
            echo "[WARNING] Corrupted $(basename "${gz_file}") detected; removing to re-download..."
            rm -f "${gz_file}"
        fi
    fi
done

# 2d. If core taxonomy (names.dmp / nodes.dmp) is still missing, download from NCBI
if [ ! -s "${TAXONOMY_DIR}/names.dmp" ] || [ ! -s "${TAXONOMY_DIR}/nodes.dmp" ]; then
    echo "names.dmp/nodes.dmp not found locally. Running kraken2-build --download-taxonomy..."
    "${KRAKEN_BUILD_BIN}" --download-taxonomy --db "${DB}" || true
fi

# 2e. Direct curl/wget fallback for taxdump if still missing (uses -k / --no-check-certificate for institutional proxies)
if [ ! -s "${TAXONOMY_DIR}/names.dmp" ] || [ ! -s "${TAXONOMY_DIR}/nodes.dmp" ]; then
    echo "Downloading fresh NCBI taxdump.tar.gz via HTTPS/HTTP..."
    rm -f "${TAXONOMY_DIR}/taxdump.tar.gz"*
    (curl -k -fsSL "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz" -o "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" || \
     curl -fsSL "http://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz" -o "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" || \
     wget --no-check-certificate -qO "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz" || \
     wget -qO "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" "http://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz")
    
    if [ -f "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" ] && tar -tzf "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" >/dev/null 2>&1; then
        mv "${TAXONOMY_DIR}/taxdump.tar.gz.tmp" "${TAXONOMY_DIR}/taxdump.tar.gz"
        tar -xzf "${TAXONOMY_DIR}/taxdump.tar.gz" -C "${TAXONOMY_DIR}/"
    else
        echo "[ERROR] Downloaded taxdump.tar.gz is incomplete or corrupted!"
        rm -f "${TAXONOMY_DIR}/taxdump.tar.gz.tmp"
    fi
fi

# 2f. Ensure accession2taxid mapping files exist
if [ ! -s "${TAXONOMY_DIR}/nucl_gb.accession2taxid" ]; then
    echo "Downloading nucl_gb.accession2taxid.gz from NCBI..."
    (curl -k -fsSL "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/nucl_gb.accession2taxid.gz" -o "${TAXONOMY_DIR}/nucl_gb.accession2taxid.gz" || \
     curl -fsSL "http://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/nucl_gb.accession2taxid.gz" -o "${TAXONOMY_DIR}/nucl_gb.accession2taxid.gz" || \
     wget --no-check-certificate -qO "${TAXONOMY_DIR}/nucl_gb.accession2taxid.gz" "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/nucl_gb.accession2taxid.gz") && \
    gunzip -f "${TAXONOMY_DIR}/nucl_gb.accession2taxid.gz" || true
fi

if [ ! -s "${TAXONOMY_DIR}/nucl_wgs.accession2taxid" ]; then
    echo "Downloading nucl_wgs.accession2taxid.gz from NCBI..."
    (curl -k -fsSL "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/nucl_wgs.accession2taxid.gz" -o "${TAXONOMY_DIR}/nucl_wgs.accession2taxid.gz" || \
     curl -fsSL "http://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/nucl_wgs.accession2taxid.gz" -o "${TAXONOMY_DIR}/nucl_wgs.accession2taxid.gz" || \
     wget --no-check-certificate -qO "${TAXONOMY_DIR}/nucl_wgs.accession2taxid.gz" "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/accession2taxid/nucl_wgs.accession2taxid.gz") && \
    gunzip -f "${TAXONOMY_DIR}/nucl_wgs.accession2taxid.gz" || true
fi

# 2g. Sync unpacked taxonomy back to GCS bucket for future reuse
echo "Synchronizing unpacked taxonomy back to GCS (${TAXONOMY_GCS}/)..."
gsutil -m rsync -r "${TAXONOMY_DIR}" "${TAXONOMY_GCS}" || true

# Copy reference FASTA from GCS to local attached disk
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Copying reference FASTA from GCS to local attached disk (${LOCAL_FASTA})..."
gsutil -m cp "${SOURCE_FASTA_GCS}" "${LOCAL_FASTA}"

# Step 3: Validate Inputs and inspect resources
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [STEP 3/6] Validating copied input files and inspecting node resources..."

if [ ! -s "${LOCAL_FASTA}" ]; then
    echo "[ERROR] Source FASTA file is missing or empty at ${LOCAL_FASTA}! Aborting build."
    exit 1
fi

REQUIRED_TAXONOMY_FILES=("nodes.dmp" "names.dmp")
for req_file in "${REQUIRED_TAXONOMY_FILES[@]}"; do
    if [ ! -s "${TAXONOMY_DIR}/${req_file}" ]; then
        echo "[ERROR] Required taxonomy file '${req_file}' is missing or empty in ${TAXONOMY_DIR}! Aborting build."
        exit 1
    fi
done

echo "=== Worker Hardware & Memory Status ==="
free -h
echo "=== Attached Disk Space Status ==="
df -h "${WORK_DISK}"
echo "=== Input Files Listing ==="
ls -lh "${LOCAL_FASTA}"
ls -lh "${TAXONOMY_DIR}"

# Step 4: Format FASTA Headers with Kraken2 Taxonomy IDs (|kraken:taxid|<ID>)
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [STEP 4/6] Formatting sequence headers with Kraken2 taxonomy IDs..."

FORMATTED_FASTA="${WORK_DISK}/kraken_tagged_${FASTA_FILENAME}"
SEQID_MAP="${DB}/seqid2taxid.map"

TAG_SCRIPT="${WORK_DISK}/scripts/tag_kraken_fasta.py"
if [ ! -f "${TAG_SCRIPT}" ]; then
    TAG_SCRIPT="/mnt/disks/staff/scripts/tag_kraken_fasta.py"
fi
if [ ! -f "${TAG_SCRIPT}" ]; then
    echo "[INFO] Downloading tag_kraken_fasta.py from GCS..."
    mkdir -p "${WORK_DISK}/scripts"
    gsutil -q cp "gs://ml-phi-staff-m277455-p-rsa-us-central1-p-a3d4/scripts/tag_kraken_fasta.py" "${WORK_DISK}/scripts/tag_kraken_fasta.py" 2>/dev/null || true
    TAG_SCRIPT="${WORK_DISK}/scripts/tag_kraken_fasta.py"
fi

if [ ! -f "${TAG_SCRIPT}" ]; then
    echo "[ERROR] Unable to locate tag_kraken_fasta.py! Aborting."
    exit 1
fi

python3 "${TAG_SCRIPT}" "${LOCAL_FASTA}" "${FORMATTED_FASTA}" "${SEQID_MAP}" "${TAXONOMY_DIR}"


# Copy mapping file into taxonomy directory as well
cp -f "${SEQID_MAP}" "${TAXONOMY_DIR}/seqid2taxid.map" 2>/dev/null || true
cp -f "${SEQID_MAP}" "${TAXONOMY_DIR}/acc2taxid.map" 2>/dev/null || true

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Adding taxonomy-tagged reference FASTA to Kraken2 library (${FORMATTED_FASTA} -> ${DB})..."
"${KRAKEN_BUILD_BIN}" --add-to-library "${FORMATTED_FASTA}" --db "${DB}"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Successfully added reference sequence to Kraken2 library."
rm -f "${FORMATTED_FASTA}"

# Step 5: Build Kraken2 Database
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [STEP 5/6] Building Kraken2 database with ${BUILD_THREADS} threads..."
"${KRAKEN_BUILD_BIN}" --build --db "${DB}" --threads "${BUILD_THREADS}"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Kraken2 build command completed."

# Verify generated database artifacts
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Verifying database artifacts in ${DB}..."
REQUIRED_K2D_FILES=("hash.k2d" "opts.k2d" "taxo.k2d")
for k2d in "${REQUIRED_K2D_FILES[@]}"; do
    if [ ! -s "${DB}/${k2d}" ]; then
        echo "[ERROR] Expected Kraken2 database artifact '${k2d}' is missing or empty in ${DB}! Aborting."
        exit 1
    fi
done
echo "=== Final Kraken2 Database Artifacts ==="
ls -lh "${DB}"/*.k2d

# Step 6: Upload completed database directory and verify in GCS
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [STEP 6/6] Uploading completed database directory to ${DEST_GCS}/..."
# Synchronize database files including taxonomy into the destination GCS folder
gsutil -m rsync -r "${DB}" "${DEST_GCS}"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Verifying uploaded database in GCS (${DEST_GCS}/)..."
gsutil ls -lh "${DEST_GCS}/"

for k2d in "${REQUIRED_K2D_FILES[@]}"; do
    if ! gsutil -q stat "${DEST_GCS}/${k2d}"; then
        echo "[ERROR] GCS verification failed: '${DEST_GCS}/${k2d}' was not found in destination bucket! Aborting."
        exit 1
    fi
done

echo "[$(date '+%Y-%m-%d %H:%M:%S')] All database artifacts successfully confirmed in GCS!"

# Upload final build log to GCS
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Preserving build execution log in GCS..."
gsutil cp "${BUILD_LOG}" "gs://${LOG_GCS_DEST}/"

echo "=========================================================================================="
echo " Kraken2 Database Build Job Successfully Completed"
echo " End Timestamp: $(date '+%Y-%m-%d %H:%M:%S %Z')"
echo "=========================================================================================="
