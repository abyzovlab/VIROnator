# =========================================================================================================================
# SSC Coverage Module Job Template
# =========================================================================================================================

job_name={dataset}_COVERAGE
job_identifier={dataset}_[SAMPLE]


####
#### Buckets
####

# bucket location to read inputs 
input_bucket=gs://{output_bucket}/{coverage_jobexec_dirname}/output
# bucket location to write outputs 
output_bucket=gs://{output_bucket}/{coverage_jobexec_dirname}/output

# bucket location to write log outputs 
log_bucket=gs://{output_bucket}/{coverage_jobexec_dirname}/logs


####
#### Tools
####

repo=gs://ml-65e4-phi-biotools-p-rsa-us-central1-p/jobexec/repositories/rocky8.repo
tool=samtools


####
#### Post-Job Configuration
####

clear_output=true
clear_input=true


####
#### Script to run
####

commands_start

# Set unbuffered output and log environment setup
set -x

echo "=== JOBEXEC WORKER PROCESS STARTED ==="
echo "Node Hostname: $(hostname)"
echo "Current Directory: $(pwd)"
echo "PATH: ${PATH}"

PHASE="{phase}"
PROJECT="{project}"
SAMPLE="[SAMPLE]"
SAMPLE_METADATA="{sample_metadata_path}"
DATA_BUCKET="{data_bucket}"
DATA_SUBDIR="{data_subdir}"
GCS_WGS_BASE="gs://${DATA_BUCKET}/${DATA_SUBDIR}"
DATA_DIR="{data_dir}"
INPUT_KEYWORD="{input_keyword}"
INPUT_SUFFIX="{input_suffix}"

# Strip leading/trailing dots if provided in variables
INPUT_KEYWORD="${INPUT_KEYWORD#.}"
INPUT_KEYWORD="${INPUT_KEYWORD%.}"
INPUT_SUFFIX="${INPUT_SUFFIX#.}"
if [ -z "${INPUT_SUFFIX}" ]; then
    INPUT_SUFFIX="cram"
fi

# Dynamically construct target input filename pattern with mandatory dot after SAMPLE
if [ -n "${INPUT_KEYWORD}" ]; then
    TARGET_FILENAME="${SAMPLE}.${INPUT_KEYWORD}.${INPUT_SUFFIX}"
else
    TARGET_FILENAME="${SAMPLE}.${INPUT_SUFFIX}"
fi

# Determine base input directory from data_dir and data_subdir
if [ -n "${DATA_SUBDIR}" ]; then
    BASE_INPUT_DIR="${DATA_DIR}/${DATA_SUBDIR}"
else
    BASE_INPUT_DIR="${DATA_DIR}"
fi

# Directory paths
if [ -z "${PHASE}" ] || [ "${PHASE}" = "none" ] || [ "${PHASE}" = "0" ]; then
    PHASE_SUBDIR=""
else
    PHASE_SUBDIR="phase${PHASE}"
fi

if [ -z "${PROJECT}" ] || [ "${PROJECT}" = "base" ] || [ "${PROJECT}" = "none" ]; then
    PROJECT_SUBDIR=""
else
    PROJECT_SUBDIR="${PROJECT}"
fi

if [ -n "${PHASE_SUBDIR}" ] && [ -n "${PROJECT_SUBDIR}" ]; then
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}/${PHASE_SUBDIR}/${PROJECT_SUBDIR}"
elif [ -n "${PHASE_SUBDIR}" ]; then
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}/${PHASE_SUBDIR}"
elif [ -n "${PROJECT_SUBDIR}" ]; then
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}/${PROJECT_SUBDIR}"
else
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}"
fi
OUT_FILE="${COVERAGE_DIR}/${SAMPLE}_coverage.tsv"

mkdir -p "${COVERAGE_DIR}"

echo "[DIAGNOSTIC] SAMPLE: ${SAMPLE}"
echo "[DIAGNOSTIC] PHASE: phase${PHASE}"
echo "[DIAGNOSTIC] PROJECT: ${PROJECT:-base}"
echo "[DIAGNOSTIC] OUTPUT DIRECTORY: ${COVERAGE_DIR}"
echo "[DIAGNOSTIC] OUTPUT FILE: ${OUT_FILE}"

DATASET="{dataset}"
RAW_METADATA="{raw_metadata_path}"
META_SEP="{metadata_separator}"
SAMPLE_COL="{sample_id_column}"
ENABLE_SPECIMEN="{enable_specimen}"
ENABLE_TISSUE="{enable_tissue}"
ENABLE_CELL="{enable_cell}"
ENABLE_SEX="{enable_sex}"
ENABLE_RACE="{enable_race}"
ENABLE_CLINIC_NUMBER="{enable_clinic_number}"
ENABLE_AGE="{enable_age}"

SPECIMEN="Unknown"
TISSUE="Unknown"
CELL="Unknown"
SEX="Unknown"
RACE="Unknown"
CLINIC_NUMBER="Unknown"
AGE="Unknown"

if [ -f "${RAW_METADATA}" ]; then
    echo "[DIAGNOSTIC] Querying metadata from ${RAW_METADATA} (separator: ${META_SEP})..."
    eval $(python3 -c "
import sys, csv, re

raw_meta = '${RAW_METADATA}'
sep_mode = '${META_SEP}'.strip().lower()
target_sample = '${SAMPLE}'
sample_col = '${SAMPLE_COL}'.strip().lower()
dataset_name = '${DATASET}'.strip()

enable_spec = '${ENABLE_SPECIMEN}' == 'on'
enable_tissue = '${ENABLE_TISSUE}' == 'on'
enable_cell = '${ENABLE_CELL}' == 'on'
enable_sex = '${ENABLE_SEX}' == 'on'
enable_race = '${ENABLE_RACE}' == 'on'
enable_cn = '${ENABLE_CLINIC_NUMBER}' == 'on'
enable_age = '${ENABLE_AGE}' == 'on'

spec, tissue, cell, sex, race, cn, age = 'Unknown', 'Unknown', 'Unknown', 'Unknown', 'Unknown', 'Unknown', 'Unknown'

try:
    with open(raw_meta, 'r', encoding='utf-8', errors='replace') as f:
        delim = '\t'
        if sep_mode == 'comma' or sep_mode == ',':
            delim = ','
        elif sep_mode == 'auto':
            sample_text = f.read(4096)
            f.seek(0)
            try:
                dialect = csv.Sniffer().sniff(sample_text)
                delim = dialect.delimiter
            except Exception:
                delim = '\t' if '\t' in sample_text else ','
        
        sys.stderr.write(f'[PYTHON DIAGNOSTIC] Opening {raw_meta}, delim: \"{delim}\", target_sample: \"{target_sample}\", sample_col: \"{sample_col}\", dataset: \"{dataset_name}\"\n')
        
        reader = csv.reader(f, delimiter=delim)
        header = next(reader, None)
        if header:
            header_clean = [c.strip().lower() for c in header]
            sys.stderr.write(f'[PYTHON DIAGNOSTIC] Header columns: {header_clean}\n')
            s_idx = header_clean.index(sample_col) if sample_col in header_clean else 0
            sys.stderr.write(f'[PYTHON DIAGNOSTIC] sample_col \"{sample_col}\" resolved to index: {s_idx}\n')
            
            spec_idx = header_clean.index('specimen') if 'specimen' in header_clean else -1
            tissue_idx = header_clean.index('tissue') if 'tissue' in header_clean else -1
            cell_idx = header_clean.index('cell') if 'cell' in header_clean else (-1 if 'cell_line' not in header_clean else header_clean.index('cell_line'))
            sex_idx = header_clean.index('sex') if 'sex' in header_clean else -1
            race_idx = header_clean.index('race') if 'race' in header_clean else -1
            cn_idx = header_clean.index('clinic_number') if 'clinic_number' in header_clean else (-1 if 'clinic_no' not in header_clean else header_clean.index('clinic_no'))
            age_idx = header_clean.index('age') if 'age' in header_clean else -1
            
            sys.stderr.write(f'[PYTHON DIAGNOSTIC] Column indices -> spec: {spec_idx}, tissue: {tissue_idx}, sex: {sex_idx}, race: {race_idx}, cn: {cn_idx}, age: {age_idx}\n')

            checked_count = 0
            for row in reader:
                checked_count += 1
                if len(row) > s_idx:
                    raw_val = row[s_idx].strip()
                    clean_r = re.sub(r'^(sample_|s_|mayo-clinic_)', '', raw_val.lower(), flags=re.IGNORECASE)
                    clean_t = re.sub(r'^(sample_|s_|mayo-clinic_)', '', target_sample.lower(), flags=re.IGNORECASE)
                    
                    is_match = (raw_val == target_sample) or (clean_r == clean_t)
                    
                    if not is_match and dataset_name.lower() == 'mcbiobank':
                        st_match_t = re.search(r'st[-_]?(\d+)', target_sample.lower())
                        if st_match_t:
                            target_st_num = int(st_match_t.group(1))
                            r_digits = re.findall(r'\d+', raw_val)
                            if r_digits and any(int(d) == target_st_num for d in r_digits):
                                is_match = True

                    if is_match:
                        sys.stderr.write(f'[PYTHON DIAGNOSTIC] MATCH FOUND on row {checked_count}! raw_val=\"{raw_val}\"\n')
                        if enable_spec and spec_idx != -1 and len(row) > spec_idx and row[spec_idx].strip():
                            spec = row[spec_idx].strip()
                        if enable_tissue and tissue_idx != -1 and len(row) > tissue_idx and row[tissue_idx].strip():
                            tissue = row[tissue_idx].strip()
                        if enable_cell and cell_idx != -1 and len(row) > cell_idx and row[cell_idx].strip():
                            cell = row[cell_idx].strip()
                        if enable_sex and sex_idx != -1 and len(row) > sex_idx and row[sex_idx].strip():
                            sex = row[sex_idx].strip()
                        if enable_race and race_idx != -1 and len(row) > race_idx and row[race_idx].strip():
                            race = row[race_idx].strip()
                        if enable_cn and cn_idx != -1 and len(row) > cn_idx and row[cn_idx].strip():
                            cn = row[cn_idx].strip()
                        if enable_age and age_idx != -1 and len(row) > age_idx and row[age_idx].strip():
                            age = row[age_idx].strip()
                        break
            if not is_match:
                sys.stderr.write(f'[PYTHON DIAGNOSTIC] Checked {checked_count} rows, NO MATCH found for target \"{target_sample}\"\n')
except Exception as e:
    sys.stderr.write(f'[PYTHON DIAGNOSTIC ERROR] Exception occurred: {str(e)}\n')

def esc(v): return re.sub(r'[^A-Za-z0-9_.\s-]', '_', str(v))
print(f'SPECIMEN=\"{esc(spec)}\"; TISSUE=\"{esc(tissue)}\"; CELL=\"{esc(cell)}\"; SEX=\"{esc(sex)}\"; RACE=\"{esc(race)}\"; CLINIC_NUMBER=\"{esc(cn)}\"; AGE=\"{esc(age)}\";')
")
fi

echo "[DIAGNOSTIC] METADATA -> SPECIMEN: ${SPECIMEN} | TISSUE: ${TISSUE} | CELL: ${CELL} | SEX: ${SEX} | RACE: ${RACE} | CLINIC_NUMBER: ${CLINIC_NUMBER} | AGE: ${AGE}"

# Locating human CRAM on mounted filesystem (/mnt/disks/lab)
echo "[DIAGNOSTIC] Locating human CRAM file on mounted filesystem (${DATA_DIR})..."

CRAM=""
# Candidate paths depending on whether PHASE and/or PROJECT are set
if [ -n "${PHASE}" ] && [ "${PHASE}" != "none" ] && [ "${PHASE}" != "0" ]; then
    if [ -n "${PROJECT}" ] && [ "${PROJECT}" != "base" ] && [ "${PROJECT}" != "none" ]; then
        CRAM="${BASE_INPUT_DIR}/phase${PHASE}/CRAM/${PROJECT}/Sample_${SAMPLE}/analysis/${TARGET_FILENAME}"
        [ ! -f "${CRAM}" ] && CRAM="${BASE_INPUT_DIR}/phase${PHASE}/CRAM/${PROJECT}/${TARGET_FILENAME}"
    else
        CRAM="${BASE_INPUT_DIR}/phase${PHASE}/CRAM/${TARGET_FILENAME}"
    fi
else
    if [ -n "${PROJECT}" ] && [ "${PROJECT}" != "base" ] && [ "${PROJECT}" != "none" ]; then
        CRAM="${BASE_INPUT_DIR}/${PROJECT}/${TARGET_FILENAME}"
    else
        CRAM="${BASE_INPUT_DIR}/${TARGET_FILENAME}"
    fi
fi

# Fallback search if candidate path does not exist
if [ -z "${CRAM}" ] || [ ! -f "${CRAM}" ]; then
    CRAM=$(find "${BASE_INPUT_DIR}" -name "${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

echo "[DIAGNOSTIC] RESOLVED CRAM FILE: ${CRAM}"

if [ -z "${CRAM}" ] || [ ! -f "${CRAM}" ]; then
    echo "[ERROR] CRAM file not found for sample '${SAMPLE}' in '${BASE_INPUT_DIR}'!"
    echo "[ERROR] Cannot calculate coverage without a valid input alignment file. Exiting."
    exit 1
fi

# Dynamically construct full CRAM_URL for provenance output
if [ -n "${DATA_BUCKET}" ]; then
    # Convert local mount path (/mnt/disks/lab/sub/path/file.cram) to GCS URL (gs://bucket/sub/path/file.cram)
    REL_PATH="${CRAM#${DATA_DIR}/}"
    REL_PATH="${REL_PATH#/}"
    CRAM_URL="gs://${DATA_BUCKET}/${REL_PATH}"
else
    CRAM_URL="${CRAM}"
fi

echo "[DIAGNOSTIC] CRAM URL: ${CRAM_URL}"

# 1. Attempt fast index query first via samtools idxstats (.crai / .bai)
GENOME_SIZE=0
MAPPED_READS=0

echo "[DIAGNOSTIC] Attempting fast query via samtools idxstats..."
IDXSTATS_OUT=$(samtools idxstats "${CRAM}" 2>/dev/null || echo "")

if [ -n "${IDXSTATS_OUT}" ]; then
    eval $(echo "${IDXSTATS_OUT}" | awk '
        $1 != "*" { ref_len += $2; mapped += $3 }
        END { printf "GENOME_SIZE=%d; MAPPED_READS=%d;", ref_len, mapped }
    ')
fi

# 2. If idxstats failed or .crai was missing, fall back to extracting GENOME_SIZE from CRAM header (@SQ LN)
if [ -z "${GENOME_SIZE}" ] || [ "${GENOME_SIZE}" -eq 0 ]; then
    echo "[DIAGNOSTIC] Index query unavailable/empty. Extracting reference genome size directly from CRAM header (@SQ LN)..."
    GENOME_SIZE=$(samtools view -H "${CRAM}" 2>/dev/null | awk '$1=="@SQ" {for(i=1;i<=NF;i++) if($i ~ /^LN:/) {split($i,a,":"); sum+=a[2]}} END {print sum}')
fi

# 3. If mapped reads unavailable from index, count mapped reads via samtools view -c -F 4
if [ -z "${MAPPED_READS}" ] || [ "${MAPPED_READS}" -eq 0 ]; then
    echo "[DIAGNOSTIC] Index query unavailable for mapped reads. Counting mapped reads via samtools view -c -F 4..."
    MAPPED_READS=$(samtools view -c -F 4 "${CRAM}" 2>/dev/null || echo "0")
fi

echo "[DIAGNOSTIC] TOTAL REFERENCE LENGTH (BP): ${GENOME_SIZE}"
echo "[DIAGNOSTIC] TOTAL MAPPED READS: ${MAPPED_READS}"

if [ "${MAPPED_READS}" -gt 0 ] && [ "${GENOME_SIZE}" -gt 0 ]; then
    COVERAGE=$(awk -v reads="${MAPPED_READS}" -v gsz="${GENOME_SIZE}" 'BEGIN {printf "%.2f", (reads * 150.0) / gsz}')
else
    echo "[ERROR] Mapped reads count or reference size is 0 for sample '${SAMPLE}'!"
    exit 1
fi

echo "[DIAGNOSTIC] CALCULATED COVERAGE: ${COVERAGE}"

# Dynamically assemble TSV header and row values based on active metadata switches
HEADER_COLS=("sample" "coverage")
ROW_COLS=("${SAMPLE}" "${COVERAGE}")

if [ "${ENABLE_SPECIMEN}" = "on" ]; then
    HEADER_COLS+=("specimen")
    ROW_COLS+=("${SPECIMEN}")
fi
if [ "${ENABLE_TISSUE}" = "on" ]; then
    HEADER_COLS+=("tissue")
    ROW_COLS+=("${TISSUE}")
fi
if [ "${ENABLE_CELL}" = "on" ]; then
    HEADER_COLS+=("cell")
    ROW_COLS+=("${CELL}")
fi
if [ "${ENABLE_SEX}" = "on" ]; then
    HEADER_COLS+=("sex")
    ROW_COLS+=("${SEX}")
fi
if [ "${ENABLE_RACE}" = "on" ]; then
    HEADER_COLS+=("race")
    ROW_COLS+=("${RACE}")
fi
if [ "${ENABLE_CLINIC_NUMBER}" = "on" ]; then
    HEADER_COLS+=("clinic_number")
    ROW_COLS+=("${CLINIC_NUMBER}")
fi
if [ "${ENABLE_AGE}" = "on" ]; then
    HEADER_COLS+=("age")
    ROW_COLS+=("${AGE}")
fi

HEADER_COLS+=("phase" "project" "cram_url")
ROW_COLS+=("phase${PHASE}" "${PROJECT:-base}" "${CRAM_URL:-NONE}")

HEADER_LINE=$(IFS=$'\t'; echo "${HEADER_COLS[*]}")
ROW_LINE=$(IFS=$'\t'; echo "${ROW_COLS[*]}")

# Output individual sample coverage TSV
echo "[DIAGNOSTIC] Writing output file: ${OUT_FILE}..."
echo "${HEADER_LINE}" > "${OUT_FILE}"
echo "${ROW_LINE}" >> "${OUT_FILE}"

echo "[DIAGNOSTIC] Output File Size: $(ls -lh "${OUT_FILE}")"
echo "=== END COVERAGE CALCULATION (SUCCESS) ==="
