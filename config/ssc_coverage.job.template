# =========================================================================================================================
# SSC Coverage Module Job Template
# =========================================================================================================================

job_name={dataset}_COVERAGE
job_identifier={dataset}_[SAMPLE]
machine_type={machine_type}


####
#### Buckets
####

# bucket location to read inputs 
input_bucket=gs://{output_bucket}/{coverage_jobexec_dirname}/output
# bucket location to write outputs 
output_bucket=gs://{output_bucket}/{coverage_jobexec_dirname}/output

# bucket location to write log outputs 
log_bucket=gs://{output_bucket}/{coverage_jobexec_dirname}/logs


####
#### Tools
####

repo=gs://ml-65e4-phi-biotools-p-rsa-us-central1-p/jobexec/repositories/rocky8.repo
tool=samtools


####
#### Post-Job Configuration
####

clear_output=true
clear_input=true


####
#### Script to run
####

commands_start

# Set unbuffered output and log environment setup
set -x

echo "=== JOBEXEC WORKER PROCESS STARTED ==="
echo "Node Hostname: $(hostname)"
echo "Current Directory: $(pwd)"
echo "PATH: ${PATH}"
PHASE="{phase}"
PROJECT="{project}"

# Support plus delimiter (PHASE+PROJECT+SAMPLE or PHASE+SAMPLE) in sample list
RAW_SAMPLE="[SAMPLE]"
if [[ "${RAW_SAMPLE}" == *"+"* ]]; then
    IFS='+' read -r -a PARTS <<< "${RAW_SAMPLE}"
    if [ ${#PARTS[@]} -ge 3 ]; then
        PHASE="${PARTS[0]}"
        PROJECT="${PARTS[1]}"
        SAMPLE="${PARTS[2]}"
    elif [ ${#PARTS[@]} -eq 2 ]; then
        PHASE="${PARTS[0]}"
        PROJECT=""
        SAMPLE="${PARTS[1]}"
    fi
    echo "[PARSER] Extracted from token -> PHASE: '${PHASE}', PROJECT: '${PROJECT}', SAMPLE: '${SAMPLE}'"
else
    SAMPLE="${RAW_SAMPLE}"
fi

SAMPLE_METADATA="{sample_metadata_path}"
DATA_BUCKET="{data_bucket}"
DATA_SUBDIR="{data_subdir}"
GCS_WGS_BASE="gs://${DATA_BUCKET}/${DATA_SUBDIR}"
DATA_DIR="{data_dir}"
INPUT_KEYWORD="{input_keyword}"
INPUT_SUFFIX="{input_suffix}"

# Strip leading/trailing dots if provided in variables
INPUT_KEYWORD="${INPUT_KEYWORD#.}"
INPUT_KEYWORD="${INPUT_KEYWORD%.}"
INPUT_SUFFIX="${INPUT_SUFFIX#.}"
if [ -z "${INPUT_SUFFIX}" ]; then
    INPUT_SUFFIX="cram"
fi

# Dynamically construct target input filename pattern with mandatory dot after SAMPLE
if [ -n "${INPUT_KEYWORD}" ]; then
    TARGET_FILENAME="${SAMPLE}.${INPUT_KEYWORD}.${INPUT_SUFFIX}"
else
    TARGET_FILENAME="${SAMPLE}.${INPUT_SUFFIX}"
fi

# Determine base input directory from data_dir and data_subdir
if [ -n "${DATA_SUBDIR}" ]; then
    BASE_INPUT_DIR="${DATA_DIR}/${DATA_SUBDIR}"
else
    BASE_INPUT_DIR="${DATA_DIR}"
fi

# Directory paths
if [ -z "${PHASE}" ] || [ "${PHASE}" = "none" ] || [ "${PHASE}" = "0" ]; then
    PHASE_SUBDIR=""
else
    PHASE_CLEAN="${PHASE#phase}"
    if [[ "${PHASE_CLEAN}" =~ ^[0-9]+(-[0-9]+)?$ ]]; then
        PHASE_SUBDIR="phase${PHASE_CLEAN}"
    else
        PHASE_SUBDIR="${PHASE}"
    fi
fi

if [ -z "${PROJECT}" ] || [ "${PROJECT}" = "base" ] || [ "${PROJECT}" = "none" ]; then
    PROJECT_SUBDIR=""
else
    PROJECT_SUBDIR="${PROJECT}"
fi

if [ -n "${PHASE_SUBDIR}" ] && [ -n "${PROJECT_SUBDIR}" ]; then
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}/${PHASE_SUBDIR}/${PROJECT_SUBDIR}"
elif [ -n "${PHASE_SUBDIR}" ]; then
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}/${PHASE_SUBDIR}"
elif [ -n "${PROJECT_SUBDIR}" ]; then
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}/${PROJECT_SUBDIR}"
else
    COVERAGE_DIR="{output_dir}/{coverage_out_dirname}"
fi
OUT_FILE="${COVERAGE_DIR}/${SAMPLE}_coverage.tsv"

mkdir -p "${COVERAGE_DIR}"

echo "[DIAGNOSTIC] SAMPLE: ${SAMPLE}"
echo "[DIAGNOSTIC] PHASE: ${PHASE_SUBDIR}"
echo "[DIAGNOSTIC] PROJECT: ${PROJECT:-base}"
echo "[DIAGNOSTIC] OUTPUT DIRECTORY: ${COVERAGE_DIR}"
echo "[DIAGNOSTIC] OUTPUT FILE: ${OUT_FILE}"

DATASET="{dataset}"
RAW_METADATA="{raw_metadata_path}"
META_SEP="{metadata_separator}"
SAMPLE_COL="{sample_id_column}"
PHASE_COL="{phase_column}"
PROJECT_COL="{project_column}"

TMP_META="${COVERAGE_DIR}/.meta_${SAMPLE}_$$"
META_HEADER=""
META_ROW=""

if [ -f "${RAW_METADATA}" ]; then
    echo "[DIAGNOSTIC] Querying metadata from ${RAW_METADATA} (separator: ${META_SEP})..."
    
    # Standardize target sample ID lookup key
    LOOKUP_KEY="${SAMPLE}"
    if [ "${DATASET}" = "MCBiobank" ] || [ "${DATASET}" = "mcbiobank" ]; then
        # Extract number after 'ST' and strip leading zeros (e.g. s_3595-ST-0002 -> 2)
        ST_NUM=$(echo "${SAMPLE}" | grep -o -i -E 'st[-_]?[0-9]+' | grep -o -E '[0-9]+' | sed 's/^0*//')
        if [ -n "${ST_NUM}" ]; then
            LOOKUP_KEY="${ST_NUM}"
        fi
    fi
    echo "[DIAGNOSTIC] Metadata lookup key resolved to: '${LOOKUP_KEY}'"

    # Determine delimiter for awk (-F)
    DELIM=","
    if [ "${META_SEP}" = "tab" ] || [ "${META_SEP}" = "\t" ]; then
        DELIM="\t"
    elif [ "${META_SEP}" = "auto" ]; then
        head -n 1 "${RAW_METADATA}" | grep -q $'\t' && DELIM="\t" || DELIM=","
    fi

    # Parse ALL metadata columns using awk (matching sampleID, phase, and project cumulatively)
    awk -F "${DELIM}" -v key="${LOOKUP_KEY}" -v raw_s="${SAMPLE}" \
        -v s_col="${SAMPLE_COL}" -v p_col="${PHASE_COL}" -v prj_col="${PROJECT_COL}" \
        -v cur_phase="${PHASE_CLEAN:-${PHASE}}" -v cur_proj="${PROJECT}" \
        -v tmp_base="${TMP_META}" '
        function clean(val) {
            gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", val)
            return val
        }
        function esc(val) {
            gsub(/[\t\r\n]/, " ", val)
            return val
        }
        NR == 1 {
            for (i=1; i<=NF; i++) {
                h = tolower(clean($i))
                raw_headers[i] = clean($i)
                if (h == tolower(s_col) || (!s_idx && (h == "sample" || h == "sample_id" || h == "sscid" || h == "id"))) s_idx = i
                if (h == tolower(p_col) || (!phase_idx && (h == "phase" || h == "cohort_phase"))) phase_idx = i
                if (h == tolower(prj_col) || (!proj_idx && (h == "project" || h == "study" || h == "batch"))) proj_idx = i
            }
            if (!s_idx) s_idx = 1
            
            meta_count = 0
            for (i=1; i<=NF; i++) {
                h = tolower(raw_headers[i])
                if (i != s_idx && i != phase_idx && i != proj_idx && h != "coverage" && h != "mapped_reads" && h != "read_size" && h != "human_genome_size" && h != "cram_url") {
                    meta_count++
                    meta_indices[meta_count] = i
                    meta_names[meta_count] = raw_headers[i]
                }
            }
            next
        }
        {
            r_val = clean($s_idx)
            m_val = r_val
            sub(/^0+/, "", m_val)
            
            s_match = (r_val == raw_s || r_val == key || m_val == key)
            if (s_match) {
                p_match = 1
                if (phase_idx && cur_phase != "" && cur_phase != "none" && cur_phase != "base" && cur_phase != "0") {
                    row_p = clean($phase_idx)
                    gsub(/^[Pp]hase/, "", row_p)
                    tgt_p = cur_phase
                    gsub(/^[Pp]hase/, "", tgt_p)
                    if (tolower(row_p) != tolower(tgt_p)) p_match = 0
                }
                proj_match = 1
                if (proj_idx && cur_proj != "" && cur_proj != "none" && cur_proj != "base") {
                    row_prj = tolower(clean($proj_idx))
                    if (row_prj != tolower(cur_proj)) proj_match = 0
                }
                if (p_match && proj_match) {
                    found = 1
                    for (m=1; m<=meta_count; m++) {
                        idx = meta_indices[m]
                        val = (idx <= NF) ? clean($idx) : ""
                        meta_vals[m] = (val != "" && val != "NONE") ? esc(val) : "Unknown"
                    }
                    print "[AWK DIAGNOSTIC] CUMULATIVE MATCH FOUND on row " NR "! sample_val=\"" r_val "\" phase_val=\"" (phase_idx ? clean($phase_idx) : "N/A") "\" project_val=\"" (proj_idx ? clean($proj_idx) : "N/A") "\"" > "/dev/stderr"
                    exit
                }
            }
        }
        END {
            hdr_str = ""
            for (m=1; m<=meta_count; m++) {
                hdr_str = (m == 1) ? meta_names[m] : (hdr_str "\t" meta_names[m])
            }
            print hdr_str > (tmp_base "_hdr.tmp")
            
            row_str = ""
            for (m=1; m<=meta_count; m++) {
                val = found ? meta_vals[m] : "Unknown"
                row_str = (m == 1) ? val : (row_str "\t" val)
            }
            print row_str > (tmp_base "_row.tmp")
            
            if (!found) {
                print "[AWK DIAGNOSTIC] Checked " NR " rows. NO MATCH FOUND for key \"" key "\" (phase=\"" cur_phase "\", project=\"" cur_proj "\"). Metadata columns will default to Unknown." > "/dev/stderr"
            }
        }
    ' "${RAW_METADATA}"

    if [ -f "${TMP_META}_hdr.tmp" ] && [ -s "${TMP_META}_hdr.tmp" ]; then
        META_HEADER=$(cat "${TMP_META}_hdr.tmp")
        META_ROW=$(cat "${TMP_META}_row.tmp")
        rm -f "${TMP_META}_hdr.tmp" "${TMP_META}_row.tmp"
        echo "[DIAGNOSTIC] Metadata attributes extracted successfully (${META_HEADER})"
    fi
else
    echo "[DIAGNOSTIC WARNING] Metadata file not found: '${RAW_METADATA}'. Proceeding without external metadata annotations."
fi

# Locating human CRAM on mounted filesystem (${BASE_INPUT_DIR})
echo "[DIAGNOSTIC] Locating human alignment file for '${SAMPLE}' (Phase: '${PHASE_SUBDIR}', Project: '${PROJECT}')..."

CRAM=""

# 1. Determine search root based on Phase (if Phase is configured and directory exists)
SEARCH_ROOT="${BASE_INPUT_DIR}"
if [ -n "${PHASE_SUBDIR}" ] && [ -d "${BASE_INPUT_DIR}/${PHASE_SUBDIR}" ]; then
    SEARCH_ROOT="${BASE_INPUT_DIR}/${PHASE_SUBDIR}"
fi

# 2. Priority 1: Fast direct candidate paths (0 ms check)
if [ -n "${PROJECT}" ] && [ "${PROJECT}" != "base" ] && [ "${PROJECT}" != "none" ]; then
    [ -f "${SEARCH_ROOT}/${PROJECT}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${PROJECT}/${TARGET_FILENAME}"
    [ -z "${CRAM}" ] && [ -f "${SEARCH_ROOT}/${PROJECT}/${SAMPLE}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${PROJECT}/${SAMPLE}/${TARGET_FILENAME}"
    [ -z "${CRAM}" ] && [ -f "${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}"
else
    [ -f "${SEARCH_ROOT}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${TARGET_FILENAME}"
    [ -z "${CRAM}" ] && [ -f "${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}"
fi

# 3. Priority 2: Sequence-aware lookup honoring Phase -> Project -> Target File
# Handles arbitrary nesting (e.g. CRAM/, Sample_XXX/, analysis/, etc.) without hardcoded folder names
if [ -z "${CRAM}" ] && [ -n "${PROJECT}" ] && [ "${PROJECT}" != "base" ] && [ "${PROJECT}" != "none" ]; then
    echo "[DIAGNOSTIC] Performing sequence-aware lookup (*${PROJECT}*/*${TARGET_FILENAME}) under ${SEARCH_ROOT}..."
    CRAM=$(find "${SEARCH_ROOT}" -type f -path "*${PROJECT}*${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

# 4. Priority 3: Scoped search within Phase directory
if [ -z "${CRAM}" ] && [ "${SEARCH_ROOT}" != "${BASE_INPUT_DIR}" ]; then
    echo "[DIAGNOSTIC] Scoped search within phase directory (${SEARCH_ROOT}) for ${TARGET_FILENAME}..."
    CRAM=$(find "${SEARCH_ROOT}" -type f -name "${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

# 5. Priority 4: Fallback search across entire BASE_INPUT_DIR
if [ -z "${CRAM}" ]; then
    echo "[DIAGNOSTIC] Fallback search across BASE_INPUT_DIR (${BASE_INPUT_DIR}) for ${TARGET_FILENAME}..."
    CRAM=$(find "${BASE_INPUT_DIR}" -type f -name "${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

echo "[DIAGNOSTIC] RESOLVED CRAM FILE: ${CRAM}"

if [ -z "${CRAM}" ] || [ ! -f "${CRAM}" ]; then
    echo "[ERROR] CRAM file not found for sample '${SAMPLE}' in '${BASE_INPUT_DIR}'!"
    echo "[ERROR] Cannot calculate coverage without a valid input alignment file. Exiting."
    exit 1
fi

# Dynamically construct full CRAM_URL for provenance output
if [ -n "${DATA_BUCKET}" ]; then
    # Convert local mount path (/mnt/disks/lab/sub/path/file.cram) to GCS URL (gs://bucket/sub/path/file.cram)
    REL_PATH="${CRAM#${DATA_DIR}/}"
    REL_PATH="${REL_PATH#/}"
    CRAM_URL="gs://${DATA_BUCKET}/${REL_PATH}"
else
    CRAM_URL="${CRAM}"
fi

echo "[DIAGNOSTIC] CRAM URL: ${CRAM_URL}"

# 1. Attempt fast index query first via samtools idxstats (.crai / .bai)
GENOME_SIZE=0
MAPPED_READS=0

echo "[DIAGNOSTIC] Attempting fast query via samtools idxstats..."
IDXSTATS_OUT=$(samtools idxstats "${CRAM}" 2>/dev/null || echo "")

if [ -n "${IDXSTATS_OUT}" ]; then
    eval $(echo "${IDXSTATS_OUT}" | awk '
        $1 != "*" { ref_len += $2; mapped += $3 }
        END { printf "GENOME_SIZE=%d; MAPPED_READS=%d;", ref_len, mapped }
    ')
fi

# 2. If idxstats failed or .crai was missing, fall back to extracting GENOME_SIZE from CRAM header (@SQ LN)
if [ -z "${GENOME_SIZE}" ] || [ "${GENOME_SIZE}" -eq 0 ]; then
    echo "[DIAGNOSTIC] Index query unavailable/empty. Extracting reference genome size directly from CRAM header (@SQ LN)..."
    GENOME_SIZE=$(samtools view -H "${CRAM}" 2>/dev/null | awk '$1=="@SQ" {for(i=1;i<=NF;i++) if($i ~ /^LN:/) {split($i,a,":"); sum+=a[2]}} END {print sum}')
fi

# 3. If mapped reads unavailable from index, count mapped reads via samtools view -c -F 4
if [ -z "${MAPPED_READS}" ] || [ "${MAPPED_READS}" -eq 0 ]; then
    echo "[DIAGNOSTIC] Index query unavailable for mapped reads. Counting mapped reads via samtools view -c -F 4..."
    MAPPED_READS=$(samtools view -c -F 4 "${CRAM}" 2>/dev/null || echo "0")
fi

echo "[DIAGNOSTIC] TOTAL REFERENCE LENGTH (BP): ${GENOME_SIZE}"
echo "[DIAGNOSTIC] TOTAL MAPPED READS: ${MAPPED_READS}"

if [ "${MAPPED_READS}" -gt 0 ] && [ "${GENOME_SIZE}" -gt 0 ]; then
    COVERAGE=$(awk -v reads="${MAPPED_READS}" -v gsz="${GENOME_SIZE}" 'BEGIN {printf "%.2f", (reads * 150.0) / gsz}')
else
    echo "[ERROR] Mapped reads count or reference size is 0 for sample '${SAMPLE}'!"
    exit 1
fi

echo "[DIAGNOSTIC] CALCULATED COVERAGE: ${COVERAGE}"

READ_SIZE=150

# Core coverage and provenance columns
CORE_HEADERS=("sample" "coverage" "mapped_reads" "read_size" "human_genome_size" "phase" "project" "cram_url")
CORE_VALUES=("${SAMPLE}" "${COVERAGE}" "${MAPPED_READS}" "${READ_SIZE}" "${GENOME_SIZE}" "${PHASE_SUBDIR}" "${PROJECT:-base}" "${CRAM_URL:-NONE}")

CORE_HEADER_STR=$(IFS=$'\t'; echo "${CORE_HEADERS[*]}")
CORE_ROW_STR=$(IFS=$'\t'; echo "${CORE_VALUES[*]}")

# Output individual sample coverage TSV
echo "[DIAGNOSTIC] Writing output file: ${OUT_FILE}..."
if [ -n "${META_HEADER}" ]; then
    printf "%s\t%s\n" "${CORE_HEADER_STR}" "${META_HEADER}" > "${OUT_FILE}"
    printf "%s\t%s\n" "${CORE_ROW_STR}" "${META_ROW}" >> "${OUT_FILE}"
else
    printf "%s\n" "${CORE_HEADER_STR}" > "${OUT_FILE}"
    printf "%s\n" "${CORE_ROW_STR}" >> "${OUT_FILE}"
fi

echo "[DIAGNOSTIC] Output File Size: $(ls -lh "${OUT_FILE}")"
echo "=== END COVERAGE CALCULATION (SUCCESS) ==="
