# =========================================================================================================================
# example job file

job_name=SSC_ALIGN
job_identifier=phase{phase}_[SAMPLE]


####
#### Buckets
####

# bucket location to read inputs 
input_bucket=gs://{output_bucket}/{unmapped_jobexec_dirname}/output
# bucket location to write outputs 
output_bucket=gs://{output_bucket}/{vironator_jobexec_dirname}/output

# bucket location to write log outputs 
log_bucket=gs://{output_bucket}/{vironator_jobexec_dirname}/logs


####
#### Inputs
####

# inputs to load from input_bucket (if bucket not specified in the path the input bucket is prepended) 
#input=*.txt

####
#### Tools
####

repo=gs://ml-65e4-phi-biotools-p-rsa-us-central1-p/jobexec/repositories/rocky8.repo
tool=samtools
#repo=gs://ml-phi-staff-m199584-p-rsa-us-central1-p-d707/repositories/rocky8.repo
#tool=cnvpytor

####
#### Outputs
####

# outputs to copy to output_bucket (supports wildcards, bare path assumes local_storage_output, 
# $JOBEXEC_OUTPUT prefix is the same. $JOBEXEC_PROCESS copies from local_storage_path )
#output=*

####
#### Logs
####

# outputs to copy to the log_bucket ( bare path assumes local_storage_output, $JOBEXEC_OUTPUT 
# prefix is the same. $JOBEXEC_PROCESS copies from local_storage_path )
#log="$JOBEXEC_PROCESS/${job_identifier}_system_stats"

####
#### Post-Job Configuration
####

# purge $JOBEXEC_OUTPUT upon completion
clear_output=true

# purge $JOBEXEC_INPUT upon completion
clear_input=true 


####
#### Script to run
####

# commands and scripts (executed in sequence). Executing in $JOBEXEC_PROCESS. 
commands_start

set -ex

echo "Start: $(date)"

# Consolidated global variables (populated dynamically by Snakemake)
REF_HUMAN_FULL="{ref_human_full}"
REF_HUMAN_NO_EBV="{ref_human_no_ebv}"
REF_VIRAL_BASE="{ref_viral_base}"
REF_PLASMIDS="{ref_plasmids}"
REF_MOUSE="{ref_mouse}"
REF_VIR_CONT="{ref_vir_cont}"
REF_COMBINED_DEFAULT="{ref_combined_default}"
REF_DECOY="{ref_decoy}"
REF_RNA="{ref_rna}"

VIRAL_CONTIGS="{viral_contigs_path}"
VIRAL_BED="{viral_bed_path}"
PLASMID_CONTIGS="{plasmid_contigs_path}"
MOUSE_CONTIGS="{mouse_contigs_path}"

BWA_BIN="{bwa_bin}"
EXOGENE_PYTHON_DIR="{exogene_python_dir}"
INIT_REF_SCRIPT="{init_ref_script_path}"
COMBINED_REFS_DIR="{combined_refs_dir_path}"

ALIGN_AND_FILTER="{align_and_filter}"
ALIGN_ONLY="{align_only}"
FILTER_ONLY="{filter_only}"
CONTAMINATION_QUANTIFICATION="{contamination_quantification}"

PHASE="{phase}"
PROJECT="{project}"
SAMPLE="[SAMPLE]"

# Directories
if [ -z "${PROJECT}" ]; then
    INPUT_CRAM="{output_dir}/{unmapped_out_dirname}/phase${PHASE}/${SAMPLE}.unmapped.cram"
    OUT_DIR="{output_dir}/{vironator_out_dirname}/phase${PHASE}/${SAMPLE}"
else
    INPUT_CRAM="{output_dir}/{unmapped_out_dirname}/phase${PHASE}/${PROJECT}/${SAMPLE}.unmapped.cram"
    OUT_DIR="{output_dir}/{vironator_out_dirname}/phase${PHASE}/${PROJECT}/${SAMPLE}"
fi

echo "INPUT CRAM: ${INPUT_CRAM}"
echo "OUTPUT DIR: ${OUT_DIR}"
echo "ALIGN AND FILTER: ${ALIGN_AND_FILTER}"
echo "ALIGN ONLY: ${ALIGN_ONLY}"
echo "FILTER ONLY: ${FILTER_ONLY}"
echo "CONTAMINATION QUANTIFICATION: ${CONTAMINATION_QUANTIFICATION}"

# Ensure output and log directories exist
mkdir -p "${OUT_DIR}"
LOG_FILE="${OUT_DIR}/software.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# ==============================================================================
# PART 1: ALIGNMENT TO VIRAL DATABASE & COMBINED REFERENCE (optional)
# ==============================================================================
if [ "${ALIGN_AND_FILTER}" = "on" ] || [ "${ALIGN_ONLY}" = "on" ]; then

    # 1. Prepare Foreign Database (REF_VIR_CONT = Viral + Plasmids + Mouse)
    if [ -f "${REF_VIR_CONT}" ] && [ -f "${REF_VIR_CONT}.ann" ] && [ -f "${REF_VIR_CONT}.fai" ]; then
        echo "REF_VIR_CONT database and indices already available: ${REF_VIR_CONT}"
    else
        echo "Building REF_VIR_CONT database..."
        if [ -f "${REF_VIRAL_BASE}" ]; then
            cat "${REF_VIRAL_BASE}" > "${REF_VIR_CONT}"
            [ -f "${REF_PLASMIDS}" ] && cat "${REF_PLASMIDS}" >> "${REF_VIR_CONT}"
            [ -f "${REF_MOUSE}" ] && cat "${REF_MOUSE}" >> "${REF_VIR_CONT}"
        fi
        if [ ! -f "${REF_VIR_CONT}.ann" ]; then
            "${BWA_BIN}" index "${REF_VIR_CONT}"
        fi
        if [ ! -f "${REF_VIR_CONT}.fai" ]; then
            samtools faidx "${REF_VIR_CONT}"
        fi
    fi

    # 2. Prepare Combined Database (REF_COMBINED = Human No-EBV + REF_VIR_CONT)
    BASENAME_HUMAN=$(basename "${REF_HUMAN_NO_EBV}")
    BASENAME_HUMAN_NOEXT=$(printf '%s' "${BASENAME_HUMAN}" | rev | cut -d'.' -f2- | rev)
    BASENAME_VIR_CONT=$(basename "${REF_VIR_CONT}")
    BASENAME_VIR_CONT_NOEXT=$(printf '%s' "${BASENAME_VIR_CONT}" | rev | cut -d'.' -f2- | rev)
    COMBINED_BASENAME="combined_${BASENAME_HUMAN_NOEXT}_${BASENAME_VIR_CONT_NOEXT}.fa"
    COMBINED_REF="${COMBINED_REFS_DIR}/${COMBINED_BASENAME}"

    if [ -f "${COMBINED_REF}" ] && [ -f "${COMBINED_REF}.ann" ] && [ -f "${COMBINED_REF}.fai" ]; then
        echo "Combined reference and indices already available: ${COMBINED_REF}"
    else
        echo "Building combined reference (Human No-EBV + REF_VIR_CONT)..."
        bash "${INIT_REF_SCRIPT}" -i "${REF_HUMAN_NO_EBV}" -v "${REF_VIR_CONT}" -o "${COMBINED_REF}" -b "${BWA_BIN}"
        if [ ! -f "${COMBINED_REF}.ann" ]; then
            "${BWA_BIN}" index "${COMBINED_REF}"
        fi
        if [ ! -f "${COMBINED_REF}.fai" ]; then
            samtools faidx "${COMBINED_REF}"
        fi
    fi

    # Ensure decoy and RNA references are BWA indexed if needed
    [ ! -f "${REF_DECOY}.ann" ] && "${BWA_BIN}" index "${REF_DECOY}"
    [ ! -f "${REF_RNA}.ann" ] && "${BWA_BIN}" index "${REF_RNA}"

    # 3. Step 1: Alignment to foreign reference database (REF_VIR_CONT)
    echo "STEP 1) ALIGNMENT TO FOREIGN REFERENCE DATABASE"
    samtools fastq -@ 4 -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" \
        | "${BWA_BIN}" mem -k 30 -t 20 "${REF_VIR_CONT}" - \
        | egrep -v '^@' \
        | awk '$3 != "*"' \
        > "${OUT_DIR}/viral_reads_se.reads_temp"

    # Filter temp mapping against viral contig names
    awk 'NR==FNR{a[$1]; next} $3 in a' "${VIRAL_CONTIGS}" "${OUT_DIR}/viral_reads_se.reads_temp" \
        | gzip -c \
        > "${OUT_DIR}/viral_reads_se.reads.gz"

    echo "STEP 1 DONE"

    # 3. Step 2: Read Filtering & Contamination Submodule
    echo "STEP 2) FILTERING"
    VIRAL_READS="${OUT_DIR}/viral_reads_se.reads.gz"
    
    gzip -cd "${VIRAL_READS}" | cut -f6 | sed s/'[0-9]'//g > "${OUT_DIR}/viral_reads_se.cigar"
    gzip -cd "${VIRAL_READS}" | paste "${OUT_DIR}/viral_reads_se.cigar" - | awk '{print ">"$2"\n"$11}' > "${OUT_DIR}/viral_reads_se.fa"
    fgrep ">" "${OUT_DIR}/viral_reads_se.fa" | cut -b2- | sort | uniq > "${OUT_DIR}/viral_reads_se.ids"

    if [ "${CONTAMINATION_QUANTIFICATION}" = "on" ]; then
        echo "Contamination Quantification Submodule: ACTIVE"
        
        # High-confidence Plasmid candidate IDs (MAPQ >= 20, Primary alignments only)
        if [ -f "${PLASMID_CONTIGS}" ]; then
            awk 'NR==FNR{a[$1]; next} ($3 in a) && ($5 >= 20)' "${PLASMID_CONTIGS}" "${OUT_DIR}/viral_reads_se.reads_temp" \
                | awk '{print $1}' | sed 's|/[12]$||' | sort -u > "${OUT_DIR}/plasmid_reads_se.ids"
        else
            touch "${OUT_DIR}/plasmid_reads_se.ids"
        fi

        # High-confidence Mouse candidate IDs (MAPQ >= 20, Primary alignments only)
        if [ -f "${MOUSE_CONTIGS}" ]; then
            awk 'NR==FNR{a[$1]; next} ($3 in a) && ($5 >= 20)' "${MOUSE_CONTIGS}" "${OUT_DIR}/viral_reads_se.reads_temp" \
                | awk '{print $1}' | sed 's|/[12]$||' | sort -u > "${OUT_DIR}/mouse_reads_se.ids"
        else
            touch "${OUT_DIR}/mouse_reads_se.ids"
        fi

        # Blacklist Subtraction: viral_clean = viral_raw - (plasmid_ids + mouse_ids)
        cat "${OUT_DIR}/plasmid_reads_se.ids" "${OUT_DIR}/mouse_reads_se.ids" | sort -u > "${OUT_DIR}/contamination.blacklist"
        comm -23 <(sort "${OUT_DIR}/viral_reads_se.ids") "${OUT_DIR}/contamination.blacklist" > "${OUT_DIR}/viral_reads_se.keep"
    else
        echo "Contamination Quantification Submodule: OFF (Default viral-only)"
        cat "${OUT_DIR}/viral_reads_se.ids" > "${OUT_DIR}/viral_reads_se.keep"
    fi
    echo "STEP 2 DONE"

    # 4. Step 3: Retrieving mates and reconstructing paired-end FASTQ
    echo "STEP 3) RETRIEVING MATES"
    samtools view -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" \
        | python "${EXOGENE_PYTHON_DIR}/fq_to_bam_py3.py" "${OUT_DIR}/viral_reads_se.keep" "${OUT_DIR}/viral_1.fq" "${OUT_DIR}/viral_2.fq" "${OUT_DIR}/totalReads.count"

    TOTAL_PAIRS=$(cat "${OUT_DIR}/totalReads.count" 2>/dev/null || echo "0")
    if [ -z "${TOTAL_PAIRS}" ] || [ "${TOTAL_PAIRS}" -eq 0 ]; then
        TOTAL_PAIRS_VAL=1
    else
        TOTAL_PAIRS_VAL="${TOTAL_PAIRS}"
    fi

    # Unmapped pairs calculation (both mates unmapped or flag bit 4 set in unmapped CRAM)
    UNMAPPED_RAW=$(samtools view -c -f 4 -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" 2>/dev/null || echo "0")
    UNMAPPED_PAIRS=$(( UNMAPPED_RAW / 2 ))
    UNMAPPED_FRAC=$(awk -v cnt="${UNMAPPED_PAIRS}" -v tot="${TOTAL_PAIRS_VAL}" 'BEGIN {printf "%.6f", (tot > 0 ? cnt/tot : 0)}')
    printf "%d\t%d\t%s\n" "${UNMAPPED_PAIRS}" "${TOTAL_PAIRS}" "${UNMAPPED_FRAC}" > "${OUT_DIR}/unmapped_pairs.count"

    # Recover contamination statistics & CRAM output files if submodule is active
    if [ "${CONTAMINATION_QUANTIFICATION}" = "on" ]; then
        if [ -s "${OUT_DIR}/plasmid_reads_se.ids" ]; then
            samtools view -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" \
                | python "${EXOGENE_PYTHON_DIR}/fq_to_bam_py3.py" "${OUT_DIR}/plasmid_reads_se.ids" "${OUT_DIR}/plasmid_1.fq" "${OUT_DIR}/plasmid_2.fq" "${OUT_DIR}/plasmid_raw.count"
            
            # Align plasmid pairs and convert to sorted CRAM
            "${BWA_BIN}" mem -Y -k 30 -t 20 "${REF_VIR_CONT}" "${OUT_DIR}/plasmid_1.fq" "${OUT_DIR}/plasmid_2.fq" 2>> "${OUT_DIR}/bwa.log" \
                | samtools view -C -T "${REF_VIR_CONT}" - \
                | samtools sort -@ 3 -o "${OUT_DIR}/plasmid_hits.sorted.cram" -
            samtools index "${OUT_DIR}/plasmid_hits.sorted.cram"

            rm -f "${OUT_DIR}/plasmid_1.fq" "${OUT_DIR}/plasmid_2.fq"
            PLASMID_PAIRS=$(cat "${OUT_DIR}/plasmid_raw.count" 2>/dev/null || echo "0")
            rm -f "${OUT_DIR}/plasmid_raw.count"
        else
            PLASMID_PAIRS=0
        fi
        PLASMID_FRAC=$(awk -v cnt="${PLASMID_PAIRS}" -v tot="${TOTAL_PAIRS_VAL}" 'BEGIN {printf "%.6f", (tot > 0 ? cnt/tot : 0)}')
        printf "%d\t%d\t%s\n" "${PLASMID_PAIRS}" "${TOTAL_PAIRS}" "${PLASMID_FRAC}" > "${OUT_DIR}/plasmid_pairs.count"

        if [ -s "${OUT_DIR}/mouse_reads_se.ids" ]; then
            samtools view -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" \
                | python "${EXOGENE_PYTHON_DIR}/fq_to_bam_py3.py" "${OUT_DIR}/mouse_reads_se.ids" "${OUT_DIR}/mouse_1.fq" "${OUT_DIR}/mouse_2.fq" "${OUT_DIR}/mouse_raw.count"
            
            # Align mouse pairs and convert to sorted CRAM
            "${BWA_BIN}" mem -Y -k 30 -t 20 "${REF_VIR_CONT}" "${OUT_DIR}/mouse_1.fq" "${OUT_DIR}/mouse_2.fq" 2>> "${OUT_DIR}/bwa.log" \
                | samtools view -C -T "${REF_VIR_CONT}" - \
                | samtools sort -@ 3 -o "${OUT_DIR}/mouse_hits.sorted.cram" -
            samtools index "${OUT_DIR}/mouse_hits.sorted.cram"

            rm -f "${OUT_DIR}/mouse_1.fq" "${OUT_DIR}/mouse_2.fq"
            MOUSE_PAIRS=$(cat "${OUT_DIR}/mouse_raw.count" 2>/dev/null || echo "0")
            rm -f "${OUT_DIR}/mouse_raw.count"
        else
            MOUSE_PAIRS=0
        fi
        MOUSE_FRAC=$(awk -v cnt="${MOUSE_PAIRS}" -v tot="${TOTAL_PAIRS_VAL}" 'BEGIN {printf "%.6f", (tot > 0 ? cnt/tot : 0)}')
        printf "%d\t%d\t%s\n" "${MOUSE_PAIRS}" "${TOTAL_PAIRS}" "${MOUSE_FRAC}" > "${OUT_DIR}/mouse_pairs.count"
    fi
    echo "STEP 3 DONE"

    # 5. Step 4: Alignment to combined reference & decoy/RNA filtering
    echo "STEP 4) ALIGNMENT TO COMBINED REFERENCE"
    "${BWA_BIN}" mem -Y -k 30 -t 20 -v 2 "${COMBINED_REF}" "${OUT_DIR}/viral_1.fq" "${OUT_DIR}/viral_2.fq" 2> "${OUT_DIR}/bwa.log" \
        | samtools sort -@ 3 -o "${OUT_DIR}/Viral.sort.bam" -
    samtools index "${OUT_DIR}/Viral.sort.bam"

    # Align to Decoys & RNA
    echo "ALIGN TO DECOYS"
    "${BWA_BIN}" mem -Y -k 30 -t 20 "${REF_RNA}" "${OUT_DIR}/viral_reads_se.fa" 2> "${OUT_DIR}/errors.log" \
        | python "${EXOGENE_PYTHON_DIR}/aln_match_filter_py3.py" 90 > "${OUT_DIR}/rna_hits.ids" 2>> "${OUT_DIR}/errors.log"
    
    "${BWA_BIN}" mem -Y -k 30 -t 20 "${REF_DECOY}" "${OUT_DIR}/viral_reads_se.fa" 2>> "${OUT_DIR}/errors.log" \
        | python "${EXOGENE_PYTHON_DIR}/aln_match_filter_py3.py" 90 > "${OUT_DIR}/decoy_hits.ids" 2>> "${OUT_DIR}/errors.log"
    
    sort "${OUT_DIR}/rna_hits.ids" "${OUT_DIR}/decoy_hits.ids" | uniq > "${OUT_DIR}/bad.list"
    
    # Subtract decoys/RNA hits and create final exogeneSR_viral.bam
    samtools view -h "${OUT_DIR}/Viral.sort.bam" | fgrep -v -w -f "${OUT_DIR}/bad.list" | samtools view -Sb - > "${OUT_DIR}/exogeneSR_viral.bam"
    samtools index "${OUT_DIR}/exogeneSR_viral.bam"
    
    # Clean up intermediate files
    rm -f "${OUT_DIR}/Viral.sort.bam" "${OUT_DIR}/Viral.sort.bam.bai"
    echo "STEP 4 DONE"

fi

# ==============================================================================
# PART 2: FINAL FILTERING AND FORMATTING
# ==============================================================================
echo "STEP 6) FILTERING READS"

# Define the combined reference path used in the previous step
BASENAME_HUMAN=$(basename "${REF_HUMAN_NO_EBV}")
BASENAME_HUMAN_NOEXT=$(printf '%s' "${BASENAME_HUMAN}" | rev | cut -d'.' -f2- | rev)
BASENAME_VIRAL=$(basename "${REF_VIRAL}")
BASENAME_VIRAL_NOEXT=$(printf '%s' "${BASENAME_VIRAL}" | rev | cut -d'.' -f2- | rev)
COMBINED_BASENAME="combined_${BASENAME_HUMAN_NOEXT}_plus_${BASENAME_VIRAL_NOEXT}.fa"
COMBINED_REF="${COMBINED_REFS_DIR}/${COMBINED_BASENAME}"

# Extract read IDs matching length/orientation constraints under BED file regions
samtools view -F 2048 -F 12 -f 2 -q 20 "${OUT_DIR}/exogeneSR_viral.bam" --region-file "${VIRAL_BED}" \
    | awk '($9 >= 150 && $9 <= 1500) || ($9 <= -150 && $9 >= -1500)' \
    | awk '$6=="151M" || $6=="150M"' \
    | awk '$7=="="' \
    | cut -f1 | sort | uniq -c | awk '$1=="2"' | awk '{print $2}' \
    > "${OUT_DIR}/reads.ids"

samtools view -F 2048 -F 12 -q 20 "${OUT_DIR}/exogeneSR_viral.bam" --region-file "${VIRAL_BED}" \
    | gawk '((and($2,97) && !and($2,16) && ($9 >= 150 && $9 <= 1500)) || (and($2,81) && !and($2,32) && ($9 >= -1500 && $9 <= -150)) || (and($2,145) && !and($2,32) && ($9 >= 150 && $9 <= 1500)) || (and($2,161) && !and($2,16) && ($9 >= -1500 && $9 <= -150)))' \
    | awk '$6=="151M" || $6=="150M"' \
    | awk '$7=="="' \
    | cut -f1 | sort | uniq -c | awk '$1=="2"' | awk '{print $2}' \
    > "${OUT_DIR}/reads.flags.ids"

# Extract and sort filtered alignments using streaming pipes
samtools view -h -F 2048 "${OUT_DIR}/exogeneSR_viral.bam" \
    | python "${EXOGENE_PYTHON_DIR}/filter_reads.py" "${OUT_DIR}/reads.ids" \
    | samtools sort -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.bam" -

samtools view -h -F 2048 "${OUT_DIR}/exogeneSR_viral.bam" \
    | python "${EXOGENE_PYTHON_DIR}/filter_reads.py" "${OUT_DIR}/reads.flags.ids" \
    | samtools sort -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.bam" -

# Convert to CRAM format
samtools view -T "${COMBINED_REF}" -C -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.cram" "${OUT_DIR}/exogeneSR_viral_filtered.sorted.bam" 
samtools view -T "${COMBINED_REF}" -C -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.cram" "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.bam"

# Index final outputs
samtools index "${OUT_DIR}/exogeneSR_viral_filtered.sorted.cram"
samtools index "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.cram"

# Clean up all intermediate SAM, BAM, and temporary files
rm -f "${OUT_DIR}"/*body*
rm -f "${OUT_DIR}"/*header*
rm -f "${OUT_DIR}"/*.sam
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.bam*
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.flags.bam*
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.sorted.bam
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.sorted.flags.bam
rm -f "${OUT_DIR}"/viral_reads_se.cigar
rm -f "${OUT_DIR}"/viral_reads_se.fa
rm -f "${OUT_DIR}"/viral_reads_se.keep
rm -f "${OUT_DIR}"/viral_reads_se.reads_temp
rm -f "${OUT_DIR}"/viral_reads_se.reads.gz
rm -f "${OUT_DIR}"/viral_1.fq
rm -f "${OUT_DIR}"/viral_2.fq
rm -f "${OUT_DIR}"/totalReads.count
rm -f "${OUT_DIR}"/Viral.sam
rm -f "${OUT_DIR}"/Viral.bam
rm -f "${OUT_DIR}"/bwa_output.sam
rm -f "${OUT_DIR}"/bwa.log
rm -f "${OUT_DIR}"/bad.list
rm -f "${OUT_DIR}"/rna_hits.ids
rm -f "${OUT_DIR}"/decoy_hits.ids

echo "End: $(date)"

# =========================================================================================================================
