# =========================================================================================================================
# example job file

job_name=SSC_ALIGN
job_identifier=phase{phase}_[SAMPLE]


####
#### Buckets
####

# bucket location to read inputs 
input_bucket=gs://{staff_bucket}/{unmapped_jobexec_dirname}/output
# bucket location to write outputs 
output_bucket=gs://{staff_bucket}/{vironator_jobexec_dirname}/output

# bucket location to write log outputs 
log_bucket=gs://{staff_bucket}/{vironator_jobexec_dirname}/logs


####
#### Inputs
####

# inputs to load from input_bucket (if bucket not specified in the path the input bucket is prepended) 
#input=*.txt

####
#### Tools
####

repo=gs://ml-65e4-phi-biotools-p-rsa-us-central1-p/jobexec/repositories/rocky8.repo
tool=samtools
#repo=gs://ml-phi-staff-m199584-p-rsa-us-central1-p-d707/repositories/rocky8.repo
#tool=cnvpytor

####
#### Outputs
####

# outputs to copy to output_bucket (supports wildcards, bare path assumes local_storage_output, 
# $JOBEXEC_OUTPUT prefix is the same. $JOBEXEC_PROCESS copies from local_storage_path )
#output=*

####
#### Logs
####

# outputs to copy to the log_bucket ( bare path assumes local_storage_output, $JOBEXEC_OUTPUT 
# prefix is the same. $JOBEXEC_PROCESS copies from local_storage_path )
#log="$JOBEXEC_PROCESS/${job_identifier}_system_stats"

####
#### Post-Job Configuration
####

# purge $JOBEXEC_OUTPUT upon completion
clear_output=true

# purge $JOBEXEC_INPUT upon completion
clear_input=true 


####
#### Script to run
####

# commands and scripts (executed in sequence). Executing in $JOBEXEC_PROCESS. 
commands_start

# Load cluster modules before execution
module load samtools bwa python jobexec/2.0.1

set -ex

echo "Start: $(date)"

# Consolidated global variables (populated dynamically by Snakemake)
REF_HUMAN_FULL="{ref_human_full}"
REF_HUMAN_NO_EBV="{ref_human_no_ebv}"
REF_VIRAL="{ref_viral}"
REF_COMBINED_DEFAULT="{ref_combined_default}"
REF_DECOY="{ref_decoy}"
REF_RNA="{ref_rna}"

VIRAL_CONTIGS="{viral_contigs_path}"
VIRAL_BED="{viral_bed_path}"

BWA_BIN="{bwa_bin}"
EXOGENE_PYTHON_DIR="{exogene_python_dir}"
INIT_REF_SCRIPT="{init_ref_script_path}"
COMBINED_REFS_DIR="{combined_refs_dir_path}"

ALIGNMENT_MODE="{alignment_mode}"

PHASE="{phase}"
PROJECT="{project}"
SAMPLE="[SAMPLE]"

# Directories
INPUT_CRAM="{staff_dir}/{unmapped_out_dirname}/phase${PHASE}/${PROJECT}/${SAMPLE}.unmapped.cram"
OUT_DIR="{staff_dir}/{vironator_out_dirname}/phase${PHASE}/${PROJECT}/${SAMPLE}"

echo "INPUT CRAM: ${INPUT_CRAM}"
echo "OUTPUT DIR: ${OUT_DIR}"

# Ensure output and log directories exist
mkdir -p "${OUT_DIR}"
LOG_FILE="${OUT_DIR}/software.log"
exec > >(tee -a "${LOG_FILE}") 2>&1

# ==============================================================================
# PART 1: ALIGNMENT TO VIRAL DATABASE & COMBINED REFERENCE (optional)
# ==============================================================================
if [ "${ALIGNMENT_MODE}" = "align_and_filter" ]; then

    # 1. Create a combined human + viral reference if it doesn't exist
    BASENAME_HUMAN=$(basename "${REF_HUMAN_NO_EBV}")
    BASENAME_HUMAN_NOEXT=$(printf '%s' "${BASENAME_HUMAN}" | rev | cut -d'.' -f2- | rev)
    BASENAME_VIRAL=$(basename "${REF_VIRAL}")
    BASENAME_VIRAL_NOEXT=$(printf '%s' "${BASENAME_VIRAL}" | rev | cut -d'.' -f2- | rev)
    COMBINED_BASENAME="combined_${BASENAME_HUMAN_NOEXT}_plus_${BASENAME_VIRAL_NOEXT}.fa"
    COMBINED_REF="${COMBINED_REFS_DIR}/${COMBINED_BASENAME}"

    # Ensure viral reference is indexed (BWA and samtools faidx)
    if [ ! -f "${REF_VIRAL}.ann" ]; then
        "${BWA_BIN}" index "${REF_VIRAL}"
    fi
    if [ ! -f "${REF_VIRAL}.fai" ]; then
        samtools faidx "${REF_VIRAL}"
    fi

    # Ensure decoy reference is BWA indexed
    if [ ! -f "${REF_DECOY}.ann" ]; then
        "${BWA_BIN}" index "${REF_DECOY}"
    fi

    # Ensure RNA reference is BWA indexed
    if [ ! -f "${REF_RNA}.ann" ]; then
        "${BWA_BIN}" index "${REF_RNA}"
    fi

    # Create combined reference if it doesn't exist OR if it is older than input references
    if [ ! -f "${COMBINED_REF}" ] || [ "${REF_VIRAL}" -nt "${COMBINED_REF}" ] || [ "${REF_HUMAN_NO_EBV}" -nt "${COMBINED_REF}" ]; then
        bash "${INIT_REF_SCRIPT}" -i "${REF_HUMAN_NO_EBV}" -v "${REF_VIRAL}" -o "${COMBINED_REF}"
        "${BWA_BIN}" index "${COMBINED_REF}"
        samtools faidx "${COMBINED_REF}"
        echo "Combined reference created and indexed: ${COMBINED_REF}"
    else
        echo "Combined reference already available and up to date."
        if [ ! -f "${COMBINED_REF}.ann" ]; then
            "${BWA_BIN}" index "${COMBINED_REF}"
        fi
        if [ ! -f "${COMBINED_REF}.fai" ]; then
            samtools faidx "${COMBINED_REF}"
        fi
    fi

    # 2. Step 1: Alignment to the viral database
    echo "STEP 1) ALIGNMENT TO VIRAL DATABASE"
    samtools view -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" \
        | awk '{print "@"$1"\n"$10"\n+\n"$11}' \
        | "${BWA_BIN}" mem -k 30 -t 20 "${REF_VIRAL}" - \
        | egrep -v '^@' \
        | awk '{ if ($3 != "*") print $0 }' \
        > "${OUT_DIR}/viral_reads_se.reads_temp"

    # Filter temp mapping against viral contig names
    awk 'NR==FNR{a[$1]; next} $3 in a' "${VIRAL_CONTIGS}" "${OUT_DIR}/viral_reads_se.reads_temp" \
        | gzip -c \
        > "${OUT_DIR}/viral_reads_se.reads.gz"

    echo "STEP 1 DONE"

    # 3. Step 2: Low complexity filtering (NO DUSTMASKER)
    echo "STEP 2) FILTERING"
    VIRAL_READS="${OUT_DIR}/viral_reads_se.reads.gz"
    
    gzip -cd "${VIRAL_READS}" | cut -f6 | sed s/'[0-9]'//g > "${OUT_DIR}/viral_reads_se.cigar"
    gzip -cd "${VIRAL_READS}" | paste "${OUT_DIR}/viral_reads_se.cigar" - | awk '{print ">"$2"\n"$11}' > "${OUT_DIR}/viral_reads_se.fa"
    fgrep ">" "${OUT_DIR}/viral_reads_se.fa" | cut -b2- | sort | uniq > "${OUT_DIR}/viral_reads_se.ids"
    
    cat "${OUT_DIR}/viral_reads_se.ids" > "${OUT_DIR}/viral_reads_se.keep"
    echo "STEP 2 DONE"

    # 4. Step 3: Retrieving mates and reconstructing paired-end FASTQ
    echo "STEP 3) RETRIEVING MATES"
    samtools view -F 2048 -T "${REF_HUMAN_FULL}" "${INPUT_CRAM}" \
        | python "${EXOGENE_PYTHON_DIR}/fq_to_bam_py3.py" "${OUT_DIR}/viral_reads_se.keep" "${OUT_DIR}/viral_1.fq" "${OUT_DIR}/viral_2.fq" "${OUT_DIR}/totalReads.count"
    echo "STEP 3 DONE"

    # 5. Step 4: Alignment to combined reference & decoy/RNA filtering
    echo "STEP 4) ALIGNMENT TO COMBINED REFERENCE"
    "${BWA_BIN}" mem -Y -k 30 -t 20 -v 2 "${COMBINED_REF}" "${OUT_DIR}/viral_1.fq" "${OUT_DIR}/viral_2.fq" 2> "${OUT_DIR}/bwa.log" > "${OUT_DIR}/Viral.sam"
    samtools view -bS "${OUT_DIR}/Viral.sam" > "${OUT_DIR}/Viral.bam"
    
    # Sort and Index
    samtools sort -@ 3 -T "${OUT_DIR}/Viral.bam" -o "${OUT_DIR}/Viral.sort.bam" "${OUT_DIR}/Viral.bam"
    samtools index "${OUT_DIR}/Viral.sort.bam"

    # Align to Decoys & RNA
    echo "ALIGN TO DECOYS"
    "${BWA_BIN}" mem -Y -k 30 -t 20 "${REF_RNA}" "${OUT_DIR}/viral_reads_se.fa" > "${OUT_DIR}/bwa_output.sam" 2> "${OUT_DIR}/errors.log"
    cat "${OUT_DIR}/bwa_output.sam" | python "${EXOGENE_PYTHON_DIR}/aln_match_filter_py3.py" 90 > "${OUT_DIR}/rna_hits.ids" 2>> "${OUT_DIR}/errors.log"
    
    "${BWA_BIN}" mem -Y -k 30 -t 20 "${REF_DECOY}" "${OUT_DIR}/viral_reads_se.fa" | python "${EXOGENE_PYTHON_DIR}/aln_match_filter_py3.py" 90 > "${OUT_DIR}/decoy_hits.ids" 2>> "${OUT_DIR}/errors.log"
    
    sort "${OUT_DIR}/rna_hits.ids" "${OUT_DIR}/decoy_hits.ids" | uniq > "${OUT_DIR}/bad.list"
    
    # Subtract decoys/RNA hits and create final exogeneSR_viral.bam
    samtools view -h "${OUT_DIR}/Viral.sort.bam" | fgrep -v -w -f "${OUT_DIR}/bad.list" > "${OUT_DIR}/exogeneSR_viral.sam"
    samtools view -Sb "${OUT_DIR}/exogeneSR_viral.sam" > "${OUT_DIR}/exogeneSR_viral.bam"
    samtools index "${OUT_DIR}/exogeneSR_viral.bam"
    
    # Clean up intermediate SAM/BAM files
    rm -f "${OUT_DIR}/Viral.bam" "${OUT_DIR}/Viral.sort.bam" "${OUT_DIR}/Viral.sort.bam.bai"
    echo "STEP 4 DONE"

fi

# ==============================================================================
# PART 2: FINAL FILTERING AND FORMATTING
# ==============================================================================
echo "STEP 6) FILTERING READS"

# Define the combined reference path used in the previous step
BASENAME_HUMAN=$(basename "${REF_HUMAN_NO_EBV}")
BASENAME_HUMAN_NOEXT=$(printf '%s' "${BASENAME_HUMAN}" | rev | cut -d'.' -f2- | rev)
BASENAME_VIRAL=$(basename "${REF_VIRAL}")
BASENAME_VIRAL_NOEXT=$(printf '%s' "${BASENAME_VIRAL}" | rev | cut -d'.' -f2- | rev)
COMBINED_BASENAME="combined_${BASENAME_HUMAN_NOEXT}_plus_${BASENAME_VIRAL_NOEXT}.fa"
COMBINED_REF="${COMBINED_REFS_DIR}/${COMBINED_BASENAME}"

# Extract read IDs matching length/orientation constraints under BED file regions
samtools view -F 2048 -F 12 -f 2 -q 20 "${OUT_DIR}/exogeneSR_viral.bam" --region-file "${VIRAL_BED}" \
    | awk '($9 >= 150 && $9 <= 1500) || ($9 <= -150 && $9 >= -1500)' \
    | awk '$6=="151M" || $6=="150M"' \
    | awk '$7=="="' \
    | cut -f1 | sort | uniq -c | awk '$1=="2"' | awk '{print $2}' \
    > "${OUT_DIR}/reads.ids"

samtools view -F 2048 -F 12 -q 20 "${OUT_DIR}/exogeneSR_viral.bam" --region-file "${VIRAL_BED}" \
    | gawk '((and($2,97) && !and($2,16) && ($9 >= 150 && $9 <= 1500)) || (and($2,81) && !and($2,32) && ($9 >= -1500 && $9 <= -150)) || (and($2,145) && !and($2,32) && ($9 >= 150 && $9 <= 1500)) || (and($2,161) && !and($2,16) && ($9 >= -1500 && $9 <= -150)))' \
    | awk '$6=="151M" || $6=="150M"' \
    | awk '$7=="="' \
    | cut -f1 | sort | uniq -c | awk '$1=="2"' | awk '{print $2}' \
    > "${OUT_DIR}/reads.flags.ids"

# Extract filtered alignments using exogene python scripts
samtools view -F 2048 "${OUT_DIR}/exogeneSR_viral.bam" | python "${EXOGENE_PYTHON_DIR}/filter_reads.py" "${OUT_DIR}/reads.ids" > "${OUT_DIR}/exogeneSR_viral_filtered_body.sam"
samtools view -F 2048 "${OUT_DIR}/exogeneSR_viral.bam" | python "${EXOGENE_PYTHON_DIR}/filter_reads.py" "${OUT_DIR}/reads.flags.ids" > "${OUT_DIR}/exogeneSR_viral_filtered_body.flags.sam"

samtools view -H "${OUT_DIR}/exogeneSR_viral.bam" > "${OUT_DIR}/exogeneSR_viral_filtered_header.sam"
samtools view -H "${OUT_DIR}/exogeneSR_viral.bam" > "${OUT_DIR}/exogeneSR_viral_filtered_header.flags.sam"

cat "${OUT_DIR}/exogeneSR_viral_filtered_header.sam" "${OUT_DIR}/exogeneSR_viral_filtered_body.sam" > "${OUT_DIR}/exogeneSR_viral_filtered.sam"
cat "${OUT_DIR}/exogeneSR_viral_filtered_header.flags.sam" "${OUT_DIR}/exogeneSR_viral_filtered_body.flags.sam" > "${OUT_DIR}/exogeneSR_viral_filtered.flags.sam"

# Convert filtered alignments to BAM
samtools view -bS "${OUT_DIR}/exogeneSR_viral_filtered.sam" > "${OUT_DIR}/exogeneSR_viral_filtered.bam"
samtools view -bS "${OUT_DIR}/exogeneSR_viral_filtered.flags.sam" > "${OUT_DIR}/exogeneSR_viral_filtered.flags.bam"

# Sort filtered BAM files
samtools sort "${OUT_DIR}/exogeneSR_viral_filtered.bam" -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.bam"
samtools sort "${OUT_DIR}/exogeneSR_viral_filtered.flags.bam" -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.bam"

# Convert to CRAM format
samtools view -T "${COMBINED_REF}" -C -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.cram" "${OUT_DIR}/exogeneSR_viral_filtered.sorted.bam" 
samtools view -T "${COMBINED_REF}" -C -o "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.cram" "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.bam"

# Index final outputs
samtools index "${OUT_DIR}/exogeneSR_viral_filtered.sorted.cram"
samtools index "${OUT_DIR}/exogeneSR_viral_filtered.sorted.flags.cram"

# Clean up all intermediate SAM, BAM, and temporary files
rm -f "${OUT_DIR}"/*body*
rm -f "${OUT_DIR}"/*header*
rm -f "${OUT_DIR}"/*.sam
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.bam*
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.flags.bam*
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.sorted.bam
rm -f "${OUT_DIR}"/exogeneSR_viral_filtered.sorted.flags.bam
rm -f "${OUT_DIR}"/viral_reads_se.cigar
rm -f "${OUT_DIR}"/viral_reads_se.fa
rm -f "${OUT_DIR}"/viral_reads_se.keep
rm -f "${OUT_DIR}"/viral_reads_se.reads_temp
rm -f "${OUT_DIR}"/viral_reads_se.reads.gz
rm -f "${OUT_DIR}"/viral_1.fq
rm -f "${OUT_DIR}"/viral_2.fq
rm -f "${OUT_DIR}"/totalReads.count
rm -f "${OUT_DIR}"/Viral.sam
rm -f "${OUT_DIR}"/Viral.bam
rm -f "${OUT_DIR}"/bwa_output.sam
rm -f "${OUT_DIR}"/bwa.log
rm -f "${OUT_DIR}"/bad.list
rm -f "${OUT_DIR}"/rna_hits.ids
rm -f "${OUT_DIR}"/decoy_hits.ids

echo "End: $(date)"

# =========================================================================================================================
