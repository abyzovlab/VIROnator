# =========================================================================================================================
# example job file

#job_name=SSC_UNMAPPED
#job_identifier=phase1_[ARRAY]

job_name={dataset}_UNMAPPED
job_identifier={dataset}_[SAMPLE]
machine_type={machine_type}


####
#### Buckets
####

# bucket location to read inputs 
input_bucket=gs://{output_bucket}/{unmapped_jobexec_dirname}/input
# bucket location to write outputs 
output_bucket=gs://{output_bucket}/{unmapped_jobexec_dirname}/output

# bucket location to write log outputs 
log_bucket=gs://{output_bucket}/{unmapped_jobexec_dirname}/logs


####
#### Inputs
####

# inputs to load from input_bucket (if bucket not specified in the path the input bucket is prepended) 
#input=*.txt

####
#### Tools
####

repo=gs://ml-65e4-phi-biotools-p-rsa-us-central1-p/jobexec/repositories/rocky8.repo
tool=samtools
#repo=gs://ml-phi-staff-m199584-p-rsa-us-central1-p-d707/repositories/rocky8.repo
#tool=cnvpytor

####
#### Outputs
####

# outputs to copy to output_bucket (supports wildcards, bare path assumes local_storage_output, 
# $JOBEXEC_OUTPUT prefix is the same. $JOBEXEC_PROCESS copies from local_storage_path )
#output=*

####
#### Logs
####

# outputs to copy to the log_bucket ( bare path assumes local_storage_output, $JOBEXEC_OUTPUT 
# prefix is the same. $JOBEXEC_PROCESS copies from local_storage_path )
#log="$JOBEXEC_PROCESS/${job_identifier}_system_stats"

####
#### Post-Job Configuration
####

# purge $JOBEXEC_OUTPUT upon completion
clear_output=true

# purge $JOBEXEC_INPUT upon completion
clear_input=true 


####
#### Script to run
####

# commands and scripts (executed in sequence). Executing in $JOBEXEC_PROCESS. 
commands_start

export PATH="/mnt/disks/staff/bin:${PATH}"
set -ex

echo "Start: $(date)"

# Consolidated global variables
REF_CRAM_DECODER="{ref_cram_decoder}"
PHASE="{phase}"
PROJECT="{project}"
# Support plus delimiter (PHASE+PROJECT+SAMPLE or PHASE+SAMPLE) in sample list
RAW_SAMPLE="[SAMPLE]"
if [[ "${RAW_SAMPLE}" == *"+"* ]]; then
    IFS='+' read -r -a PARTS <<< "${RAW_SAMPLE}"
    if [ ${#PARTS[@]} -ge 3 ]; then
        PHASE="${PARTS[0]}"
        PROJECT="${PARTS[1]}"
        SAMPLE="${PARTS[2]}"
    elif [ ${#PARTS[@]} -eq 2 ]; then
        PHASE="${PARTS[0]}"
        PROJECT=""
        SAMPLE="${PARTS[1]}"
    fi
    echo "[PARSER] Extracted from token -> PHASE: '${PHASE}', PROJECT: '${PROJECT}', SAMPLE: '${SAMPLE}'"
else
    SAMPLE="${RAW_SAMPLE}"
fi

DATA_SUBDIR="{data_subdir}"
INPUT_KEYWORD="{input_keyword}"
INPUT_SUFFIX="{input_suffix}"

# Strip leading/trailing dots if provided in variables
INPUT_KEYWORD="${INPUT_KEYWORD#.}"
INPUT_KEYWORD="${INPUT_KEYWORD%.}"
INPUT_SUFFIX="${INPUT_SUFFIX#.}"
if [ -z "${INPUT_SUFFIX}" ]; then
    INPUT_SUFFIX="cram"
fi

# Dynamically construct target input filename pattern with mandatory dot after SAMPLE
if [ -n "${INPUT_KEYWORD}" ]; then
    TARGET_FILENAME="${SAMPLE}.${INPUT_KEYWORD}.${INPUT_SUFFIX}"
else
    TARGET_FILENAME="${SAMPLE}.${INPUT_SUFFIX}"
fi

# Determine base input directory from data_dir and data_subdir
if [ -n "${DATA_SUBDIR}" ]; then
    BASE_INPUT_DIR="{data_dir}/${DATA_SUBDIR}"
else
    BASE_INPUT_DIR="{data_dir}"
fi

if [ -z "${PROJECT}" ] || [ "${PROJECT}" = "base" ] || [ "${PROJECT}" = "none" ]; then
    PROJECT_CLEAN=""
else
    PROJECT_CLEAN="${PROJECT}"
fi

if [ -z "${PHASE}" ] || [ "${PHASE}" = "none" ] || [ "${PHASE}" = "0" ]; then
    PHASE_SUBDIR=""
else
    PHASE_CLEAN="${PHASE#phase}"
    if [[ "${PHASE_CLEAN}" =~ ^[0-9]+(-[0-9]+)?$ ]]; then
        PHASE_SUBDIR="phase${PHASE_CLEAN}"
    else
        PHASE_SUBDIR="${PHASE}"
    fi
fi

# Locating human CRAM on mounted filesystem (${BASE_INPUT_DIR})
echo "[DIAGNOSTIC] Locating human alignment file for '${SAMPLE}' (Phase: '${PHASE_SUBDIR}', Project: '${PROJECT_CLEAN}')..."

CRAM=""

# 1. Determine search root based on Phase (if Phase is configured and directory exists)
SEARCH_ROOT="${BASE_INPUT_DIR}"
if [ -n "${PHASE_SUBDIR}" ] && [ -d "${BASE_INPUT_DIR}/${PHASE_SUBDIR}" ]; then
    SEARCH_ROOT="${BASE_INPUT_DIR}/${PHASE_SUBDIR}"
fi

# 2. Priority 1: Fast direct candidate paths (0 ms check)
if [ -n "${PROJECT_CLEAN}" ] && [ "${PROJECT_CLEAN}" != "base" ] && [ "${PROJECT_CLEAN}" != "none" ]; then
    [ -f "${SEARCH_ROOT}/${PROJECT_CLEAN}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${PROJECT_CLEAN}/${TARGET_FILENAME}"
    [ -z "${CRAM}" ] && [ -f "${SEARCH_ROOT}/${PROJECT_CLEAN}/${SAMPLE}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${PROJECT_CLEAN}/${SAMPLE}/${TARGET_FILENAME}"
    [ -z "${CRAM}" ] && [ -f "${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}"
else
    [ -f "${SEARCH_ROOT}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${TARGET_FILENAME}"
    [ -z "${CRAM}" ] && [ -f "${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}" ] && CRAM="${SEARCH_ROOT}/${SAMPLE}/${TARGET_FILENAME}"
fi

# 3. Priority 2: Sequence-aware lookup honoring Phase -> Project -> Target File
# Handles arbitrary nesting (e.g. CRAM/, Sample_XXX/, analysis/, etc.) without hardcoded folder names
if [ -z "${CRAM}" ] && [ -n "${PROJECT_CLEAN}" ] && [ "${PROJECT_CLEAN}" != "base" ] && [ "${PROJECT_CLEAN}" != "none" ]; then
    echo "[DIAGNOSTIC] Performing sequence-aware lookup (*${PROJECT_CLEAN}*/*${TARGET_FILENAME}) under ${SEARCH_ROOT}..."
    CRAM=$(find "${SEARCH_ROOT}" -type f -path "*${PROJECT_CLEAN}*${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

# 4. Priority 3: Scoped search within Phase directory
if [ -z "${CRAM}" ] && [ "${SEARCH_ROOT}" != "${BASE_INPUT_DIR}" ]; then
    echo "[DIAGNOSTIC] Scoped search within phase directory (${SEARCH_ROOT}) for ${TARGET_FILENAME}..."
    CRAM=$(find "${SEARCH_ROOT}" -type f -name "${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

# 5. Priority 4: Fallback search across entire BASE_INPUT_DIR
if [ -z "${CRAM}" ]; then
    echo "[DIAGNOSTIC] Fallback search across BASE_INPUT_DIR (${BASE_INPUT_DIR}) for ${TARGET_FILENAME}..."
    CRAM=$(find "${BASE_INPUT_DIR}" -type f -name "${TARGET_FILENAME}" 2>/dev/null | head -n 1)
fi

# Determine output directory
if [ -n "${PHASE_SUBDIR}" ] && [ -n "${PROJECT_CLEAN}" ]; then
    OUT_DIR="{output_dir}/{unmapped_out_dirname}/${PHASE_SUBDIR}/${PROJECT_CLEAN}"
elif [ -n "${PHASE_SUBDIR}" ]; then
    OUT_DIR="{output_dir}/{unmapped_out_dirname}/${PHASE_SUBDIR}"
else
    OUT_DIR="{output_dir}/{unmapped_out_dirname}"
fi
OUT_CRAM="${OUT_DIR}/${SAMPLE}.unmapped.cram"

echo "INPUT CRAM: ${CRAM}"
echo "OUTPUT CRAM: ${OUT_CRAM}"

# Configure REF_PATH so samtools can resolve CRAM references in ref_dir
export REF_PATH="/mnt/disks/staff/refs/%s:/mnt/disks/staff/refs/%s.fa"

if [ -d "/mnt/disks/staff/refs" ]; then
    if [ ! -f "/mnt/disks/staff/refs/GRCh38_full_analysis_set_plus_decoy_hla.fa" ] && [ -f "${REF_CRAM_DECODER}" ]; then
        ln -s "${REF_CRAM_DECODER}" /mnt/disks/staff/refs/GRCh38_full_analysis_set_plus_decoy_hla.fa 2>/dev/null || true
        [ -f "${REF_CRAM_DECODER}.fai" ] && ln -s "${REF_CRAM_DECODER}.fai" /mnt/disks/staff/refs/GRCh38_full_analysis_set_plus_decoy_hla.fa.fai 2>/dev/null || true
    fi
fi

echo "$(date) Starting extraction: ${SAMPLE}"
samtools view -@ 4 -T "${REF_CRAM_DECODER}" -F 256 --rf 12 -C -o "${OUT_CRAM}" "${CRAM}"
status=$?
echo "$(date) samtools exit code: ${status}"

if [ $status -ne 0 ]; then
    echo "$(date) EXTRACTION FAILED"
    exit $status
fi

echo "$(date) EXTRACTION FINISHED SUCCESSFULLY"

samtools quickcheck "${OUT_CRAM}" && \
    echo "$(date) OUTPUT CRAM VERIFIED"

echo "End: $(date)"

# =========================================================================================================================
